<Window x:Class="PLCTesting.Views.SystemSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置"
        Width="500"
        Height="720"
        MinHeight="560"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        Background="{StaticResource AppPageBg}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="20,18,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 页头 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Border Style="{StaticResource PageTitleIcon}">
                <TextBlock Text="⚙" FontSize="17" Foreground="{StaticResource AppAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="系统设置" Style="{StaticResource TxtPageTitle}" />
                <TextBlock Text="启动方式与版本更新" Style="{StaticResource TxtSubtitle}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- ===== 内容 ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 运行方式 -->
                <TextBlock Text="运行方式" Style="{StaticResource TxtSection}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Content="开机自启动 —— 登录 Windows 时自动在后台运行本程序"
                                  IsChecked="{Binding AutoStartOnBoot}" />
                        <TextBlock Margin="22,8,0,0" Style="{StaticResource TxtCaption}" TextWrapping="Wrap"
                                   LineHeight="18"
                                   Text="只写入当前用户的启动项，不需要管理员权限。开机启动时不弹窗口，直接在托盘安静运行；PLC 连接、数据入库与 MQTT 发布均照常工作。" />
                        <TextBlock Margin="22,6,0,0" Style="{StaticResource TxtCaption}" TextWrapping="Wrap"
                                   LineHeight="18"
                                   Text="平时双击图标打开：正常显示登录界面和主窗口。关闭主窗口时可选择缩到托盘继续后台运行。" />
                    </StackPanel>
                </Border>

                <!-- 自动更新 -->
                <TextBlock Text="自动更新" Style="{StaticResource TxtSection}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 版本行 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="当前版本" Style="{StaticResource TxtCaption}" VerticalAlignment="Center" />
                                <TextBlock Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppText}"
                                           Text="{Binding Update.CurrentVersionText, Mode=OneWay}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource AppAccentSoft}"
                                    CornerRadius="10" Padding="9,3">
                                <TextBlock FontSize="11" Foreground="{StaticResource AppAccent}"
                                           Text="{Binding Update.LatestVersionText, StringFormat='最新 {0}'}" />
                            </Border>
                        </Grid>

                        <CheckBox Content="自动检测新版本" IsChecked="{Binding UpdateCheckEnabled}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="检测到后自动安装（不提示，装完自动重启）"
                                  IsChecked="{Binding UpdateAutoInstall}"
                                  IsEnabled="{Binding UpdateCheckEnabled}" />
                        <TextBlock Margin="22,8,0,0" Style="{StaticResource TxtCaption}" TextWrapping="Wrap"
                                   LineHeight="18"
                                   Text="不勾「自动安装」＝只提示、由你确认后再装。程序未以管理员身份运行时，安装步骤会弹一次系统授权框（UAC），这是 Windows 的限制，无法绕过。" />

                        <ProgressBar Height="5" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                     Background="{StaticResource AppSurfaceAlt}"
                                     Foreground="{StaticResource AppAccent}"
                                     BorderThickness="0"
                                     Value="{Binding Update.DownloadProgress, Mode=OneWay}"
                                     Visibility="{Binding Update.IsDownloading, Converter={StaticResource BoolToVis}}" />

                        <!-- 状态条 -->
                        <Border Style="{StaticResource HintBar}" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AppAccent}"
                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock FontSize="11" Foreground="{StaticResource AppTextSub}"
                                           TextWrapping="Wrap" Text="{Binding Update.StatusText}" />
                            </StackPanel>
                        </Border>

                        <!-- 操作按钮 -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="检查更新" Style="{StaticResource BtnSecondary}"
                                    Command="{Binding Update.CheckCommand}" />
                            <Button Content="下载并安装" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                                    Command="{Binding Update.InstallCommand}"
                                    Visibility="{Binding Update.CanInstall, Converter={StaticResource BoolToVis}}" />
                            <Button Content="跳过此版本" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding Update.SkipCommand}"
                                    Visibility="{Binding Update.CanInstall, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0" Style="{StaticResource TxtCaption}" TextWrapping="Wrap"
                                   LineHeight="18" Text="{Binding Update.ReleaseNotes}" />
                    </StackPanel>
                </Border>

                <!-- 当前状态 -->
                <TextBlock Text="当前状态" Style="{StaticResource TxtSection}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource TxtCaption}" TextWrapping="Wrap" LineHeight="18"
                               Text="{Binding StatusText}" />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== 页脚 ===== -->
        <Border Grid.Row="2" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,1,0,0"
                Padding="0,12,0,14" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource TxtCaption}"
                           Text="保存后立即生效；开机自启动下次登录 Windows 时生效。" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="保存设置" Style="{StaticResource BtnPrimary}"
                        Padding="20,7" Command="{Binding SaveCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
