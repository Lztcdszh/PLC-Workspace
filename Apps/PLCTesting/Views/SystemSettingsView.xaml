<Window x:Class="PLCTesting.Views.SystemSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置"
        Width="470"
        Height="400"
        MinHeight="370"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        Background="#E8ECF0">

    <Window.Resources>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#409EFF" />
            <Setter Property="Margin" Value="0,4,0,6" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#409EFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1A2A3A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🖥️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="系统设置" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <!-- 运行方式 -->
            <TextBlock Text="运行方式" Style="{StaticResource GroupTitle}" />
            <Border Background="White" CornerRadius="6" Padding="12">
                <StackPanel>
                    <CheckBox FontSize="11" Content="开机自启动 —— 登录 Windows 时自动在后台运行本程序"
                              IsChecked="{Binding AutoStartOnBoot}" />
                    <TextBlock Margin="22,2,0,0" FontSize="10" Foreground="#909399" TextWrapping="Wrap"
                               Text="只写入当前用户的启动项，不需要管理员权限。开机启动时不弹窗口，直接在托盘安静运行；PLC 连接、数据入库与 MQTT 发布均照常工作。" />
                    <TextBlock Margin="22,8,0,0" FontSize="10" Foreground="#909399" TextWrapping="Wrap"
                               Text="平时双击图标打开：正常显示登录界面和主窗口。关闭主窗口时也可选择缩到托盘继续后台运行。" />
                </StackPanel>
            </Border>

            <!-- 注册表实际状态 -->
            <TextBlock Text="当前状态" Style="{StaticResource GroupTitle}" Margin="0,12,0,6" />
            <Border Background="#F2F6FC" CornerRadius="6" Padding="12">
                <TextBlock FontSize="10" Foreground="#666" TextWrapping="Wrap"
                           Text="{Binding StatusText}" />
            </Border>
        </StackPanel>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#1A2A3A" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="#BDC3C7"
                           Text="保存后立即生效；开机自启动下次登录 Windows 时生效。" />
                <Button Grid.Column="1" Content="💾 保存设置" Style="{StaticResource AccentButton}"
                        Command="{Binding SaveCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
