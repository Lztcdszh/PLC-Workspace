<Window x:Class="PLCTesting.Views.ParameterSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:myplc="clr-namespace:MyPLCUserControlLibrary;assembly=MyPLCUserControlLibrary"
        Title="参数设置"
        Width="600"
        Height="640"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        Background="{StaticResource AppPageBg}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 读写数值输入：撑满卡片宽度 -->
        <Style TargetType="myplc:PlcNumericInput">
            <Setter Property="ShowCaption" Value="True" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 页头 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Style="{StaticResource PageTitleIcon}">
                    <TextBlock Text="⚙" FontSize="17" Foreground="{StaticResource AppAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="运动参数设置" Style="{StaticResource TxtPageTitle}" />
                    <TextBlock Text="加速度、限位与保护阈值" Style="{StaticResource TxtSubtitle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Content="还原参数" Style="{StaticResource BtnSecondary}"
                    VerticalAlignment="Center" Command="{Binding ResetParametersCommand}" />
        </Grid>

        <!-- ===== 参数卡片（连接级联：仅需在外层 PlcPanel 设置一次） ===== -->
        <myplc:PlcPanel Grid.Row="1" Header="📝 参数设定" Connection="{Binding Connection}" VerticalAlignment="Stretch">
            <myplc:PlcPanel.PanelContent>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel Margin="12,10,12,12">

                        <!-- 分组一：运动参数 -->
                        <TextBlock Text="运动参数" Style="{StaticResource TxtSection}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <myplc:PlcNumericInput Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" Label="加速度设置" TagName="加速时间" TagAddress="DB1.DBD220"
                                                   DataType="Int32" FormatString="F0" Unit="ms" />
                            <myplc:PlcNumericInput Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" Label="减速度设置" TagName="减速时间" TagAddress="DB1.DBD224"
                                                   DataType="Int32" FormatString="F0" Unit="ms" />
                            <myplc:PlcNumericInput Grid.Row="1" Grid.Column="0" Label="最大速度设置" TagName="最大速度" TagAddress="DB1.DBD182"
                                                   DataType="Float" FormatString="F2" Unit="度/秒" />
                            <myplc:PlcNumericInput Grid.Row="1" Grid.Column="2" Label="低速速度设置" TagName="低速速度" TagAddress="DB1.DBD186"
                                                   DataType="Float" FormatString="F2" Unit="度/秒" />
                        </Grid>

                        <!-- 分组二：位置限位 -->
                        <TextBlock Text="位置限位" Style="{StaticResource TxtSection}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <myplc:PlcNumericInput Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" Label="负极限位置" TagName="负极限位置" TagAddress="DB1.DBW270"
                                                   DataType="Int16" FormatString="F0" />
                            <myplc:PlcNumericInput Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" Label="充电位置" TagName="充电位置" TagAddress="DB1.DBW190"
                                                   DataType="Int16" FormatString="F0" />
                            <myplc:PlcNumericInput Grid.Row="1" Grid.Column="0" Label="正极限位置" TagName="正极限位置" TagAddress="DB1.DBW180"
                                                   DataType="Int16" FormatString="F0" />
                            <myplc:PlcNumericInput Grid.Row="1" Grid.Column="2" Label="故障时间设定" TagName="故障时间设定" TagAddress="DB1.DBW173"
                                                   DataType="Int16" FormatString="F0" Unit="100ms" />
                        </Grid>

                        <!-- 分组三：保护参数 -->
                        <TextBlock Text="保护参数" Style="{StaticResource TxtSection}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <myplc:PlcNumericInput Grid.Column="0" Label="低电量阈值" TagName="低电量阈值" TagAddress="DB1.DBW177"
                                                   DataType="Int16" FormatString="F0" Unit="%%%" />
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </myplc:PlcPanel.PanelContent>
        </myplc:PlcPanel>
    </Grid>
</Window>
