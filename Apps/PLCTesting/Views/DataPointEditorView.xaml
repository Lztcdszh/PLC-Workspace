<Window x:Class="PLCTesting.Views.DataPointEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PLCTesting.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="数据点管理" Height="460" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinWidth" Value="72"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="#888" FontSize="12">
            管理 dataPoints.json：决定哪些数据入库 / 发 MQTT。修改后点击"保存"，重启程序生效。
        </TextBlock>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="新增" Command="{Binding AddCommand}"/>
            <Button Content="删除" Command="{Binding RemoveCommand}"/>
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888" FontSize="12">
                共 <Run Text="{Binding Points.Count, Mode=OneWay}"/> 个数据点
            </TextBlock>
        </StackPanel>

        <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Points}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" Height="300" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Width="120" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="PLC 地址" Width="120" Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridComboBoxColumn Header="类型" Width="90"
                                        ItemsSource="{Binding DataTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                        SelectedItemBinding="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="描述" Width="160" Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridCheckBoxColumn Header="入库" Width="50" Binding="{Binding LogToDb, Mode=TwoWay}"/>
                <DataGridCheckBoxColumn Header="发MQTT" Width="64" Binding="{Binding PublishMqtt, Mode=TwoWay}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Command="{Binding SaveCommand}"/>
            <Button Content="取消" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </DockPanel>
</Window>
