<Window x:Class="PLCTesting.Views.DataPointEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PLCTesting.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="数据点管理" Height="580" Width="900"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        Background="{StaticResource AppPageBg}"
        UseLayoutRounding="True">

    <Grid Margin="20,18,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 页头 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Style="{StaticResource PageTitleIcon}">
                    <TextBlock Text="🗂" FontSize="16" Foreground="{StaticResource AppAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="数据点管理" Style="{StaticResource TxtPageTitle}" />
                    <TextBlock Text="决定哪些数据入库 / 发 MQTT，保存后立即生效" Style="{StaticResource TxtSubtitle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="新增" Style="{StaticResource BtnSecondary}" Command="{Binding AddCommand}" />
                <Button Content="删除" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding RemoveCommand}" />
            </StackPanel>
        </Grid>

        <!-- ===== 统计条 ===== -->
        <Border Grid.Row="1" Style="{StaticResource HintBar}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource TxtCaption}">
                    <Run Text="共" /><Run Text=" " />
                    <Run Text="{Binding Points.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AppText}" />
                    <Run Text=" " /><Run Text="个数据点" />
                </TextBlock>
                <TextBlock Style="{StaticResource TxtCaption}" Margin="16,0,0,0"
                           Text="双击单元格可编辑；类型下拉直接选择" />
            </StackPanel>
        </Border>

        <!-- ===== 表格 ===== -->
        <Border Grid.Row="2" Style="{StaticResource CardTight}" Padding="1">
            <DataGrid ItemsSource="{Binding Points}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Width="160" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="PLC 地址" Width="150" Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- ⚠️ 类型列必须用 DataGridTemplateColumn + ComboBox。
                         不能用 DataGridComboBoxColumn：它继承自 DataGridColumn 而非 FrameworkElement，
                         根本不在可视树里，ItemsSource 上的 RelativeSource AncestorType 解析不到，
                         绑定静默失败成 null → 下拉框是空的、什么都选不了（实测 Items=0）。
                         放进 CellTemplate 的 ComboBox 在可视树内，还能单击直接下拉，无需先双击进编辑态。 -->
                    <DataGridTemplateColumn Header="类型" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Margin="0,2" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding DataContext.DataTypeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedItem="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="描述" Width="*" Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridCheckBoxColumn Header="入库" Width="64" Binding="{Binding LogToDb, Mode=TwoWay}"/>
                    <DataGridCheckBoxColumn Header="发 MQTT" Width="82" Binding="{Binding PublishMqtt, Mode=TwoWay}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===== 页脚 ===== -->
        <Border Grid.Row="3" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,1,0,0"
                Padding="0,12,0,14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource TxtCaption}"
                           TextWrapping="Wrap" Text="修改 dataPoints.json，保存后无需重启程序。" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Style="{StaticResource BtnSecondary}" MinWidth="88"
                            Command="{Binding CancelCommand}" />
                    <Button Content="保存" Style="{StaticResource BtnPrimary}" MinWidth="88" Margin="8,0,0,0"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
