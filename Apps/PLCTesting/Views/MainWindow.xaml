<Window x:Class="PLCTesting.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:myplc="clr-namespace:MyPLCUserControlLibrary;assembly=MyPLCUserControlLibrary"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="PLC 监控台"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="1100"
        MinHeight="680"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        Background="{StaticResource AppPageBg}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 卡片标题栏：淡蓝底，压在白色卡片上做轻分隔 -->
        <LinearGradientBrush x:Key="CardHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F4F8FE" Offset="0" />
            <GradientStop Color="#EAF2FC" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="myplc:PlcPanel">
            <Setter Property="HeaderBrush" Value="{StaticResource CardHeaderBrush}" />
        </Style>

        <!-- 位置指示器状态条：公共属性归一化（TagName/TabAddress/颜色/闪烁/连接） -->
        <Style TargetType="myplc:PlcStatusBar">
            <Setter Property="TagName" Value="小车实际位置" />
            <Setter Property="TagAddress" Value="DB1.DBW240" />
            <Setter Property="ActiveBrush" Value="#FF8C00" />
            <Setter Property="InactiveBrush" Value="#C8CDD6" />
            <Setter Property="Blink" Value="True" />
            <Setter Property="Connection" Value="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
        </Style>

        <!-- 只读数值显示 -->
        <Style TargetType="myplc:PlcValueDisplay">
            <Setter Property="ValueFontSize" Value="15" />
            <Setter Property="LabelFontSize" Value="10" />
            <Setter Property="UnitFontSize" Value="9" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- 读写数值输入（参数设定）：撑满卡片宽度 -->
        <Style TargetType="myplc:PlcNumericInput">
            <Setter Property="ShowCaption" Value="True" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- 工具栏按钮：白底细边，hover 变浅蓝底；一屏只保留一个实心主按钮 -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <!-- 三行：页头 / 内容 / 页脚 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ===== 页头 ===== -->
        <Border Grid.Row="0" Background="{StaticResource AppSurface}"
                BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：标识 + 标题 + 连接状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AppAccentSoft}" Margin="0,0,10,0">
                        <TextBlock Text="🚀" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PLC 监控台" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AppText}" />
                        <TextBlock Text="骨料巡检机器人 · 实时数据与远程控制" Style="{StaticResource TxtCaption}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border Background="{StaticResource AppSurfaceAlt}" CornerRadius="14" Padding="10,4" Margin="18,0,0,0"
                            BorderBrush="{StaticResource AppBorder}" BorderThickness="1" VerticalAlignment="Center">
                        <myplc:PlcConnectionStatus Connection="{Binding Connection}" DotSize="9" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- 右侧：操作区 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="⚙ 参数设置" Style="{StaticResource ToolButton}" Command="{Binding OpenParameterSettingsCommand}" />
                    <Button Content="📋 日志查询" Style="{StaticResource ToolButton}" Command="{Binding OpenLogQueryCommand}" />
                    <Button Content="📡 MQTT 配置" Style="{StaticResource ToolButton}" Command="{Binding OpenMqttConfigCommand}" />
                    <Button Content="🗂 数据点" Style="{StaticResource ToolButton}" Command="{Binding OpenDataPointEditorCommand}" />
                    <Button Content="🖥 系统设置" Style="{StaticResource ToolButton}" Command="{Binding OpenSystemSettingsCommand}" />

                    <!-- 有新版本时才出现的提示：点它打开系统设置去安装 -->
                    <Button Content="{Binding Update.LatestVersionText, StringFormat='🆕 有新版本 {0}'}"
                            Style="{StaticResource BtnWarning}" FontSize="12" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding OpenSystemSettingsCommand}"
                            Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                            ToolTip="发现新版本，点击打开系统设置进行安装" />

                    <!-- 用户管理：仅管理员可见 -->
                    <Button Content="👤 用户管理" Command="{Binding OpenUserManagementCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanManageUsers}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 当前用户 -->
                    <Border Background="{StaticResource AppSurfaceAlt}" BorderBrush="{StaticResource AppBorder}"
                            BorderThickness="1" CornerRadius="16" Padding="10,4" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AppSuccess}"
                                     VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding CurrentUser.DisplayName, FallbackValue='未登录'}"
                                       FontSize="12" Foreground="{StaticResource AppText}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource AppAccentSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding CurrentUserRoleText}" FontSize="10"
                                           Foreground="{StaticResource AppAccent}" />
                            </Border>
                            <Button Content="退出" FontSize="11" Foreground="{StaticResource AppTextFaint}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                    Command="{Binding LogoutCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 内容区 ===== -->
        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="200" />
            </Grid.RowDefinitions>

            <!-- ===== 第一行：三个数据卡片 ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 设备运行数据 -->
                <myplc:PlcPanel Grid.Column="0" Header="📊 设备运行数据" Connection="{Binding Connection}" VerticalAlignment="Stretch">
                    <myplc:PlcPanel.PanelContent>
                        <Grid Margin="10,8,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <myplc:PlcValueDisplay Grid.Row="0" Grid.Column="0" Label="实际速度" TagName="实际速度" TagAddress="DB1.DBD1012"
                                                      DataType="Float" FormatString="F3" Unit="度/秒" />
                            <myplc:PlcNumericInput Grid.Row="0" Grid.Column="1" Label="速度设定" TagName="设置速度" TagAddress="DB1.DBD1016"
                                                       DataType="Float" FormatString="F2" Unit="度/秒" />
                            <myplc:PlcValueDisplay Grid.Row="1" Grid.Column="0" Label="电机位置" TagName="实际位置" TagAddress="DB1.DBD1004"
                                                      DataType="Float" FormatString="F3" Unit="度" />
                            <myplc:PlcValueDisplay Grid.Row="2" Grid.Column="0" Label="电机运行时间" TagName="电机运行时间" TagAddress="DB1.DBW60"
                                                      DataType="Int16" FormatString="F0" Unit="100ms" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="接近开关" Width="52" FontSize="10" Foreground="{StaticResource AppTextFaint}" VerticalAlignment="Center" />
                                <myplc:PlcIndicator Width="18" Height="18" TagName="接近开关" TagAddress="M4.0"
                                                       AutoRegister="True" OnBrush="LimeGreen" OffBrush="Red" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </myplc:PlcPanel.PanelContent>
                </myplc:PlcPanel>

                <!-- 电池状态 -->
                <myplc:PlcPanel Grid.Column="2" Header="🔋 电池状态" Connection="{Binding Connection}" VerticalAlignment="Stretch">
                    <myplc:PlcPanel.PanelContent>
                        <Grid Margin="10,8,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <myplc:PlcValueDisplay Grid.Row="0" Grid.Column="0" Label="电池电量" TagName="小车坑位位置" TagAddress="DB1.DBW290"
                                                      DataType="Int16" FormatString="F0" Unit="%" />
                            <myplc:PlcValueDisplay Grid.Row="0" Grid.Column="1" Label="电池电流" TagName="电池电流" TagAddress="DB1.DBW292"
                                                      DataType="Int16" FormatString="F0" Unit="10mA" />
                            <myplc:PlcValueDisplay Grid.Row="1" Grid.Column="0" Label="电池电压" TagName="电池电压" TagAddress="DB1.DBW714"
                                                      DataType="Int16" FormatString="F0" Unit="10mV" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="电量柱状" Width="44" FontSize="10" Foreground="{StaticResource AppTextFaint}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <myplc:PlcBarIndicator TagName="小车坑位位置" TagAddress="DB1.DBW290" DataType="Int16"
                                                         Minimum="0" Maximum="10000"
                                                         LowThreshold="2000" HighThreshold="7000"
                                                         LowBrush="#F56C6C" FillBrush="#E6A23C"
                                                         HighBrush="#67C23A" Orientation="Horizontal"
                                                         ShowValue="False" Width="88" Height="16" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </myplc:PlcPanel.PanelContent>
                </myplc:PlcPanel>

                <!-- 小车状态 -->
                <myplc:PlcPanel Grid.Column="4" Header="🚗 小车状态" Connection="{Binding Connection}" VerticalAlignment="Stretch">
                    <myplc:PlcPanel.PanelContent>
                        <Grid Margin="10,8,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <myplc:PlcValueDisplay Grid.Row="0" Grid.Column="0" Label="小车状态" TagName="小车状态" TagAddress="DB1.DBW230"
                                                      DataType="Int16" FormatString="F0" />
                            <myplc:PlcNumericInput Grid.Row="0" Grid.Column="1" Label="位置修正" TagName="小车实际位置" TagAddress="DB1.DBW240"
                                                       DataType="Int16" FormatString="F0" />
                            <myplc:PlcValueDisplay Grid.Row="1" Grid.Column="0" Label="实际位置" TagName="小车实际位置" TagAddress="DB1.DBW240"
                                                      DataType="Int16" FormatString="F0" />
                            <myplc:PlcNumericInput Grid.Row="1" Grid.Column="1" Label="目标设定" TagName="小车设定位置" TagAddress="DB1.DBW250"
                                                       DataType="Int16" FormatString="F0" />
                            <myplc:PlcValueDisplay Grid.Row="2" Grid.Column="0" Label="故障位置" TagName="小车故障位置" TagAddress="DB1.DBW175"
                                                      DataType="Int16" FormatString="F0" />
                            <myplc:PlcValueDisplay Grid.Row="2" Grid.Column="1" Label="故障代码" TagName="小车故障代码" TagAddress="DB1.DBB172"
                                                      DataType="UInt8" FormatString="F0" />
                            <!-- 模式设定：4 个 PlcSelectButton 写同一标签 DB1.DBW210，PLC 当前值==按钮写入值时高亮（绿色），天然互斥选择 -->
                            <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock Text="模式" Style="{StaticResource PlcSecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <myplc:PlcSelectButton Margin="3" Width="64" Height="30" ButtonText="停止"
                                                       WriteValue="0" WriteTagName="小车设定模式" WriteTagAddress="DB1.DBW210"
                                                       Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                                <myplc:PlcSelectButton Margin="3" Width="64" Height="30" ButtonText="自动"
                                                       WriteValue="1" WriteTagName="小车设定模式" WriteTagAddress="DB1.DBW210"
                                                       Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                                <myplc:PlcSelectButton Margin="3" Width="64" Height="30" ButtonText="复位"
                                                       WriteValue="2" WriteTagName="小车设定模式" WriteTagAddress="DB1.DBW210"
                                                       Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                                <myplc:PlcSelectButton Margin="3" Width="64" Height="30" ButtonText="手动"
                                                       WriteValue="3" WriteTagName="小车设定模式" WriteTagAddress="DB1.DBW210"
                                                       Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                            </WrapPanel>
                        </Grid>
                    </myplc:PlcPanel.PanelContent>
                </myplc:PlcPanel>
            </Grid>

            <!-- ===== 第二行：位置指示器（Canvas 蛇形连续轨道） ===== -->
            <myplc:PlcPanel Grid.Row="1" Header="📍 位置指示器（绿灯 = 当前位置；点击「选定」把号位写入小车设定位置）"
                            Connection="{Binding Connection}" Margin="0,0,0,12">
                <myplc:PlcPanel.PanelContent>
                    <Viewbox Stretch="Uniform" Margin="6,2,6,6">
                        <Canvas Width="1960" Height="350">
                            <Polyline Points="150,84 1960,84 1960,258 150,258" Stroke="#B7C2CF" StrokeThickness="6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center" Width="1863" Canvas.Left="10" />
                            <Ellipse Canvas.Left="133" Canvas.Top="67" Width="34" Height="34" Fill="#F4F8FE" Stroke="#409EFF" StrokeThickness="2" />
                            <TextBlock Canvas.Left="100" Canvas.Top="18" Width="100" Text="负极限位" FontSize="13" FontWeight="SemiBold" Foreground="#303133" TextAlignment="Center" />
                            <myplc:PlcIndicator Canvas.Left="142" Canvas.Top="76" Width="16" Height="16" TagName="负极限位" TagAddress="M4.1" AutoRegister="True" OnBrush="LimeGreen" OffBrush="Red" />
                            <Ellipse Canvas.Left="317" Canvas.Top="67" Width="34" Height="34" Fill="#F4F8FE" Stroke="#409EFF" StrokeThickness="2" />
                            <TextBlock Canvas.Left="284" Canvas.Top="18" Width="100" Text="充电位" FontSize="13" FontWeight="SemiBold" Foreground="#303133" TextAlignment="Center" />
                            <myplc:PlcRangeIndicator Canvas.Left="322" Canvas.Top="72" Width="24" Height="24" TagName="小车实际位置" TagAddress="DB1.DBW240" DataType="UInt16" Condition="Equal" CompareValue="26" TrueBrush="#67C23A" FalseBrush="#F56C6C" />
                            <myplc:PlcSelectButton Canvas.Left="301" Canvas.Top="118" Width="66" Height="32" ButtonText="选定" WriteValue="26" WriteTagAddress="DB1.DBW250" WriteTagName="小车设定位置" />
                            <Ellipse Canvas.Left="501" Canvas.Top="67" Width="34" Height="34" Fill="#F4F8FE" Stroke="#409EFF" StrokeThickness="2" />
                            <TextBlock Canvas.Left="468" Canvas.Top="18" Width="100" Text="1号位" FontSize="13" FontWeight="SemiBold" Foreground="#303133" TextAlignment="Center" />
                            <myplc:PlcRangeIndicator Canvas.Left="506" Canvas.Top="72" Width="24" Height="24" TagName="小车实际位置" TagAddress="DB1.DBW240" DataType="UInt16" Condition="Equal" CompareValue="28" TrueBrush="#67C23A" FalseBrush="#F56C6C" />
                            <myplc:PlcNumericInput Canvas.Left="555" Canvas.Top="32" Width="110" Height="52" Label="降速时间" TagName="降速时间29" TagAddress="DB1.DBW302" DataType="Int16" FormatString="F0" Unit="100ms" />
                            <myplc:PlcSelectButton Canvas.Left="485" Canvas.Top="118" Width="66" Height="32" ButtonText="选定" WriteValue="28" WriteTagAddress="DB1.DBW250" WriteTagName="小车设定位置" />
                            <Ellipse Canvas.Left="685" Canvas.Top="67" Width="34" Height="34" Fill="#F4F8FE" Stroke="#409EFF" StrokeThickness="2" />
                            <TextBlock Canvas.Left="652" Canvas.Top="18" Width="100" Text="2号位" FontSize="13" FontWeight="SemiBold" Foreground="#303133" TextAlignment="Center" />
                            <myplc:PlcRangeIndicator Canvas.Left="690" Canvas.Top="72" Width="24" Height="24" TagName="小车实际位置" TagAddress="DB1.DBW240" DataType="UInt16" Condition="Equal" CompareValue="30" TrueBrush="#67C23A" FalseBrush="#F56C6C" />
                            <myplc:PlcNumericInput Canvas.Left="739" Canvas.Top="32" Width="110" Height="52" Label="降速时间" TagName="降速时间31" TagAddress="DB1.DBW304" DataType="Int16" FormatString="F0" Unit="100ms" HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <myplc:PlcSelectButton Canvas.Left="669" Canvas.Top="118" Width="66" Height="32" ButtonText="选定" WriteValue="30" WriteTagAddress="DB1.DBW250" WriteTagName="小车设定位置" />
                            <Ellipse Canvas.Left="869" Canvas.Top="67" Width="34" Height="34" Fill="#F4F8FE" Stroke="#409EFF" StrokeThickness="2" />
                            <TextBlock Canvas.Left="836" Canvas.Top="18" Width="100" Text="3号位" FontSize="13" FontWeight="SemiBold" Foreground="#303133" TextAlignment="Center" />
                            <myplc:PlcRangeIndicator Canvas.Left="874" Canvas.Top="72" Width="24" Height="24" TagName="小车实际位置" TagAddress="DB1.DBW240" DataType="UInt16" Condition="Equal" CompareValue="32" TrueBrush="#67C23A" FalseBrush="#F56C6C" />
                            <myplc:PlcNumericInput Canvas.Left="923" Canvas.Top="32" Width="110" Height="52" Label="降速时间" TagName="降速时间33" TagAddress="DB1.DBW306" DataType="Int16" FormatString="F0" Unit="100ms" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <myplc:PlcSelectButton Canvas.Left="853" Canvas.Top="118" Width="66" Height="32" ButtonText="选定" WriteValue="32" WriteTagAddress="DB1.DBW250" WriteTagName="小车设定位置" />
                            <Ellipse Canvas.Left="1053" Canvas.Top="67" Width="34" Height="34" Fill="#F4F8FE" Stroke="#409EFF" StrokeThickness="2" />
                            <TextBlock Canvas.Left="1020" Canvas.Top="18" Width="100" Text="4号位" FontSize="13" FontWeight="SemiBold" Foreground="#303133" TextAlignment="Center" />
                            <myplc:PlcRangeIndicator Canvas.Left="1058" Canvas.Top="72" Width="24" Height="24" TagName="小车实际位置" TagAddress="DB1.DBW240" DataType="UInt16" Condition="Equal" CompareValue="34" TrueBrush="#67C23A" FalseBrush="#F56C6C" />
                            <myplc:PlcNumericInput Canvas.Left="1107" Canvas.Top="32" Width="110" Height="52" Label="降速时间" TagName="降速时间35" TagAddress="DB1.DBW308" DataType="Int16" FormatString="F0" Unit="100ms" />
                            <myplc:PlcSelectButton Canvas.Left="1037" Canvas.Top="118" Width="66" Height="32" ButtonText="选定" WriteValue="34" WriteTagAddress="DB1.DBW250" WriteTagName="小车设定位置" />
                            <Ellipse Canvas.Left="1237" Canvas.Top="67" Width="34" Height="34" Fill="#F4F8FE" Stroke="#409EFF" StrokeThickness="2" />
                            <TextBlock Canvas.Left="1204" Canvas.Top="18" Width="100" Text="5号位" FontSize="13" FontWeight="SemiBold" Foreground="#303133" TextAlignment="Center" />
                            <myplc:PlcRangeIndicator Canvas.Left="1242" Canvas.Top="72" Width="24" Height="24" TagName="小车实际位置" TagAddress="DB1.DBW240" DataType="UInt16" Condition="Equal" CompareValue="36" TrueBrush="#67C23A" FalseBrush="#F56C6C" />
                            <myplc:PlcNumericInput Canvas.Left="1291" Canvas.Top="32" Width="110" Height="52" Label="降速时间" TagName="降速时间37" TagAddress="DB1.DBW310" DataType="Int16" FormatString="F0" Unit="100ms" />
                            <myplc:PlcSelectButton Canvas.Left="1221" Canvas.Top="118" Width="66" Height="32" ButtonText="选定" WriteValue="36" WriteTagAddress="DB1.DBW250" WriteTagName="小车设定位置" />
                            <Ellipse Canvas.Left="1421" Canvas.Top="67" Width="34" Height="34" Fill="#F4F8FE" Stroke="#409EFF" StrokeThickness="2" />
                            <TextBlock Canvas.Left="1388" Canvas.Top="18" Width="100" Text="6号位" FontSize="13" FontWeight="SemiBold" Foreground="#303133" TextAlignment="Center" />
                            <myplc:PlcRangeIndicator Canvas.Left="1426" Canvas.Top="72" Width="24" Height="24" TagName="小车实际位置" TagAddress="DB1.DBW240" DataType="UInt16" Condition="Equal" CompareValue="38" TrueBrush="#67C23A" FalseBrush="#F56C6C" />
                            <myplc:PlcNumericInput Canvas.Left="1487" Canvas.Top="32" Width="110" Height="52" Label="降速时间" TagName="降速时间39" TagAddress="DB1.DBW312" DataType="Int16" FormatString="F0" Unit="100ms" />
                            <myplc:PlcSelectButton Canvas.Left="1405" Canvas.Top="118" Width="66" Height="32" ButtonText="选定" WriteValue="38" WriteTagAddress="DB1.DBW250" WriteTagName="小车设定位置" />
                            <Ellipse Canvas.Left="1605" Canvas.Top="67" Width="34" Height="34" Fill="#F4F8FE" Stroke="#409EFF" StrokeThickness="2" />
                            <TextBlock Canvas.Left="1572" Canvas.Top="18" Width="100" Text="7号位" FontSize="13" FontWeight="SemiBold" Foreground="#303133" TextAlignment="Center" />
