<Window x:Class="PLCTesting.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:myplc="clr-namespace:MyPLCUserControlLibrary;assembly=MyPLCUserControlLibrary"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="PLC监控"
        Width="1400"
        Height="870"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="900"
        MinHeight="600"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        UseLayoutRounding="True">
    <Window.Background>
        <!-- 深空科技渐变：白色仪表卡片将在其上"悬浮"发光 -->
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A1424" Offset="0" />
            <GradientStop Color="#0E2036" Offset="0.5" />
            <GradientStop Color="#0A1A2E" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <!-- ============ 科技风调色 ============ -->
        <Color x:Key="TechCyan">#00E5FF</Color>
        <Color x:Key="TechBlue">#409EFF</Color>
        <SolidColorBrush x:Key="TechCyanBrush" Color="#00E5FF" />
        <SolidColorBrush x:Key="TechTextDim" Color="#7FA8C9" />
        <!-- 顶栏 / 底栏渐变 -->
        <LinearGradientBrush x:Key="TechBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0C1B2E" Offset="0" />
            <GradientStop Color="#123A5A" Offset="0.5" />
            <GradientStop Color="#0C1B2E" Offset="1" />
        </LinearGradientBrush>
        <!-- 卡片标题栏科技渐变 -->
        <LinearGradientBrush x:Key="TechHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EAF3FF" Offset="0" />
            <GradientStop Color="#D6E9FF" Offset="1" />
        </LinearGradientBrush>
        <!-- 青色辉光 -->
        <DropShadowEffect x:Key="TechGlow" BlurRadius="14" ShadowDepth="0" Opacity="0.7" Color="#00E5FF" />
        <!-- 卡片标题栏统一科技渐变 -->
        <Style TargetType="myplc:PlcPanel">
            <Setter Property="HeaderBrush" Value="{StaticResource TechHeaderBrush}" />
        </Style>
        <!-- 位置指示器状态条：公共属性归一化（TagName/TabAddress/颜色/闪烁/连接） -->
        <Style TargetType="myplc:PlcStatusBar">
            <Setter Property="TagName" Value="小车实际位置" />
            <Setter Property="TagAddress" Value="DB1.DBW240" />
            <Setter Property="ActiveBrush" Value="#FF8C00" />
            <Setter Property="InactiveBrush" Value="#909399" />
            <Setter Property="Blink" Value="True" />
            <Setter Property="Connection" Value="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
        </Style>
        <!-- 只读数值显示 -->
        <Style TargetType="myplc:PlcValueDisplay">
            <Setter Property="ValueFontSize" Value="15" />
            <Setter Property="LabelFontSize" Value="10" />
            <Setter Property="UnitFontSize" Value="9" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- 读写数值输入（参数设定）：撑满卡片宽度 -->
        <Style TargetType="myplc:PlcNumericInput">
            <Setter Property="ShowCaption" Value="True" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- 分组小标题 -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#2B7FE0" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <!-- 位置指示器单元卡片：统一对齐的玻璃卡 -->
        <Style x:Key="PosCard" TargetType="Border">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Width" Value="166" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBDDF2" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FBFDFF" Offset="0" />
                        <GradientStop Color="#EBF3FC" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============ 科技风工具栏按钮模板 ============ -->
        <Style x:Key="TechToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="#33FFFFFF" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.85" Color="#00E5FF" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#AAF0FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" CenterX="40" CenterY="16" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- 主网格：三行（标题栏 / 内容 / 状态栏） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <!-- 顶部标题栏（科技渐变 + 底部青色辉光线） -->
        <Border Grid.Row="0" Background="{StaticResource TechBarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 左侧：标题 + 连接状态 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock Text="🚀 PLC监控"
                                   FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"
                                   Effect="{StaticResource TechGlow}" />
                        <TextBlock Text="| 实时数据 · 精准控制"
                                   FontSize="12" Foreground="{StaticResource TechTextDim}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <myplc:PlcConnectionStatus Connection="{Binding Connection}"
                                                    Margin="30,0,0,0" DotSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- 右侧：操作按钮组 + 用户区 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Button Content="⚙️ 参数设置" Style="{StaticResource TechToolButton}"
                                Background="#E6A23C" Command="{Binding OpenParameterSettingsCommand}" Margin="0,0,8,0" />
                        <Button Content="📋 日志查询" Style="{StaticResource TechToolButton}"
                                Background="#2B7FE0" Command="{Binding OpenLogQueryCommand}" Margin="0,0,8,0" />
                        <Button Content="📡 MQTT配置" Style="{StaticResource TechToolButton}"
                                Background="#3BA55C" Command="{Binding OpenMqttConfigCommand}" Margin="0,0,8,0" />
                        <!-- 用户管理：仅管理员可见 -->
                        <Button Content="👤 用户管理"
                                Background="#9B59B6" Command="{Binding OpenUserManagementCommand}" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TechToolButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanManageUsers}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- 用户区卡片 -->
                        <Border Background="#0C1B2E" BorderBrush="#2B5C82" BorderThickness="1"
                                CornerRadius="16" Padding="10,4" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="#00E5FF" Margin="0,0,8,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="#00E5FF" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="{Binding CurrentUser.DisplayName, FallbackValue='未登录'}"
                                           FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                <Border Background="#123A5A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding CurrentUserRoleText}" FontSize="10" Foreground="#9FD6FF" />
                                </Border>
                                <Button Content="退出" FontSize="10" Foreground="#B7D4EC" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"
                                        Command="{Binding LogoutCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <!-- 底部青色辉光强调线 -->
                <Border Grid.Row="1" Height="2" Background="{StaticResource TechCyanBrush}"
                        Effect="{StaticResource TechGlow}" Opacity="0.9" />
            </Grid>
        </Border>
        <!-- 内容区（自适应拉伸：卡片宽度跟随窗口拉伸无留白；文本原生渲染清晰不模糊） -->
        <Grid Grid.Row="1" Margin="12" Background="Transparent"
              UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="196" />
            </Grid.RowDefinitions>
            <!-- ===== 第一行：三个卡片（并排，宽度自适应） ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- 设备运行数据 -->
                <myplc:PlcPanel Grid.Column="0" Header="📊 设备运行数据" Connection="{Binding Connection}" VerticalAlignment="Stretch">
                    <myplc:PlcPanel.PanelContent>
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <myplc:PlcValueDisplay Grid.Row="0" Grid.Column="0" Label="实际速度" TagName="实际速度" TagAddress="DB1.DBD1012"
                                                      DataType="Float" FormatString="F3" Unit="度/秒" />
                            <myplc:PlcNumericInput Grid.Row="0" Grid.Column="1" Label="速度设定" TagName="设置速度" TagAddress="DB1.DBD1016"
                                                       DataType="Float" FormatString="F2" Unit="度/秒" />
                            <myplc:PlcValueDisplay Grid.Row="1" Grid.Column="0" Label="电机位置" TagName="实际位置" TagAddress="DB1.DBD1004"
                                                      DataType="Float" FormatString="F3" Unit="度" />

                            <myplc:PlcValueDisplay Grid.Row="2" Grid.Column="0" Label="电机运行时间" TagName="电机运行时间" TagAddress="DB1.DBW60"
                                                      DataType="Int16" FormatString="F0" Unit="100ms" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="接近开关" Width="52" FontSize="9" Foreground="#606266" VerticalAlignment="Center" />
                                <myplc:PlcIndicator Width="18" Height="18" TagName="接近开关" TagAddress="M4.0"
                                                       AutoRegister="True" OnBrush="LimeGreen" OffBrush="Red" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </myplc:PlcPanel.PanelContent>
                </myplc:PlcPanel>
                <!-- 电池状态 -->
                <myplc:PlcPanel Grid.Column="2" Header="🔋 电池状态" Connection="{Binding Connection}" VerticalAlignment="Stretch">
                    <myplc:PlcPanel.PanelContent>
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <myplc:PlcValueDisplay Grid.Row="0" Grid.Column="0" Label="电池电量" TagName="小车坑位位置" TagAddress="DB1.DBW290"
                                                      DataType="Int16" FormatString="F0" Unit="%" />
                            <myplc:PlcValueDisplay Grid.Row="0" Grid.Column="1" Label="电池电流" TagName="电池电流" TagAddress="DB1.DBW292"
                                                      DataType="Int16" FormatString="F0" Unit="10mA" />
                            <myplc:PlcValueDisplay Grid.Row="1" Grid.Column="0" Label="电池电压" TagName="电池电压" TagAddress="DB1.DBW714"
                                                      DataType="Int16" FormatString="F0" Unit="10mV" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="电量柱状" Width="44" FontSize="10" Foreground="#606266" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <myplc:PlcBarIndicator TagName="小车坑位位置" TagAddress="DB1.DBW290" DataType="Int16"
                                                         Minimum="0" Maximum="10000"
                                                         LowThreshold="2000" HighThreshold="7000"
                                                         LowBrush="#F56C6C" FillBrush="#E6A23C"
                                                         HighBrush="#67C23A" Orientation="Horizontal"
                                                         ShowValue="False" Width="88" Height="16" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </myplc:PlcPanel.PanelContent>
                </myplc:PlcPanel>
                <!-- 小车状态 -->
                <myplc:PlcPanel Grid.Column="4" Header="🚗 小车状态" Connection="{Binding Connection}" VerticalAlignment="Stretch">
                    <myplc:PlcPanel.PanelContent>
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <myplc:PlcValueDisplay Grid.Row="0" Grid.Column="0" Label="小车状态" TagName="小车状态" TagAddress="DB1.DBW230"
                                                      DataType="Int16" FormatString="F0" />
                            <myplc:PlcNumericInput Grid.Row="0" Grid.Column="1" Label="位置修正" TagName="小车实际位置" TagAddress="DB1.DBW240"
                                                       DataType="Int16" FormatString="F0" />
                            <myplc:PlcValueDisplay Grid.Row="1" Grid.Column="0" Label="实际位置" TagName="小车实际位置" TagAddress="DB1.DBW240"
                                                      DataType="Int16" FormatString="F0" />
                            <myplc:PlcNumericInput Grid.Row="1" Grid.Column="1" Label="目标设定" TagName="小车设定位置" TagAddress="DB1.DBW250"
                                                       DataType="Int16" FormatString="F0" />
                            <myplc:PlcValueDisplay Grid.Row="2" Grid.Column="0" Label="故障位置" TagName="小车故障位置" TagAddress="DB1.DBW175"
                                                      DataType="Int16" FormatString="F0" />
                            <myplc:PlcValueDisplay Grid.Row="2" Grid.Column="1" Label="故障代码" TagName="小车故障代码" TagAddress="DB1.DBB172"
                                                      DataType="UInt8" FormatString="F0" />
                            <!-- 模式设定：4 个 PlcSelectButton 写同一标签 DB1.DBW210，PLC 当前值==按钮写入值时高亮（绿色），天然互斥选择 -->
                            <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="模式设定" Style="{StaticResource PlcSecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <myplc:PlcSelectButton Margin="3" Width="64" Height="32" ButtonText="停止"
                                                       WriteValue="0" WriteTagName="小车设定模式" WriteTagAddress="DB1.DBW210"
                                                       Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                                <myplc:PlcSelectButton Margin="3" Width="64" Height="32" ButtonText="自动"
                                                       WriteValue="1" WriteTagName="小车设定模式" WriteTagAddress="DB1.DBW210"
                                                       Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                                <myplc:PlcSelectButton Margin="3" Width="64" Height="32" ButtonText="复位"
                                                       WriteValue="2" WriteTagName="小车设定模式" WriteTagAddress="DB1.DBW210"
                                                       Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                                <myplc:PlcSelectButton Margin="3" Width="64" Height="32" ButtonText="手动"
                                                       WriteValue="3" WriteTagName="小车设定模式" WriteTagAddress="DB1.DBW210"
                                                       Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                            </WrapPanel>
                        </Grid>
                    </myplc:PlcPanel.PanelContent>
                </myplc:PlcPanel>
            </Grid>
            <!-- ===== 第二行：位置指示器（直接手写各号位控件，不依赖 PositionSlots 集合） ===== -->
            <myplc:PlcPanel Grid.Row="1" Header="📍 位置指示器（绿灯=当前位置；点击「选定」将号位写入小车设定位置）" Connection="{Binding Connection}" Margin="0,0,0,8">
                <myplc:PlcPanel.PanelContent>
                    <!-- ===== 位置指示器：Canvas 蛇形连续轨道（控件贴站点） ===== -->
                    <Grid>
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Canvas Width="1450" Height="340">
                                <Polyline Points="90,95 1322,95 1322,225 90,225" Stroke="#7A8FA3" StrokeThickness="6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="74" Canvas.Top="79" Width="32" Height="32" Fill="#16324A" Stroke="#00E5FF" StrokeThickness="2.5" />
                                <TextBlock Canvas.Left="50" Canvas.Top="31" Width="80" Text="负极限位" FontSize="12" FontWeight="Bold" Foreground="#1F2D3D" TextAlignment="Center" />
                                <myplc:PlcIndicator Canvas.Left="82" Canvas.Top="87" Width="16" Height="16" TagName="负极限位" TagAddress="M4.1" AutoRegister="True" OnBrush="LimeGreen" OffBrush="Red" Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                                <Ellipse Canvas.Left="228" Canvas.Top="79" Width="32" Height="32" Fill="#16324A" Stroke="#00E5FF" StrokeThickness="2.5" />
                                <TextBlock Canvas.Left="204" Canvas.Top="31" Width="80" Text="充电位" FontSize="12" FontWeight="Bold" Foreground="#1F2D3D" TextAlignment="Center" />
                                <myplc:PlcRangeIndicator Canvas.Left="236" Canvas.Top="87" Width="16" Height="16" TagName="小车实际位置" TagAddress="DB1.DBW240" DataType="UInt16" Condition="Equal" CompareValue="26" TrueBrush="#67C23A" FalseBrush="#F56C6C" Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                                <myplc:PlcNumericInput Canvas.Left="258" Canvas.Top="47" Width="112" Height="40" Label="降速时间" TagName="降速时间27" TagAddress="DB1.DBW300" DataType="Int16" FormatString="F0" Unit="100ms" Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <myplc:PlcSelectButton Canvas.Left="214" Canvas.Top="113" Width="60" Height="26" ButtonText="选定" WriteValue="26" WriteTagAddress="DB1.DBW250" WriteTagName="小车设定位置" HorizontalAlignment="Center" Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                                <Ellipse Canvas.Left="382" Canvas.Top="79" Width="32" Height="32" Fill="#16324A" Stroke="#00E5FF" StrokeThickness="2.5" />
                                <TextBlock Canvas.Left="358" Canvas.Top="31" Width="80" Text="1号位" FontSize="12" FontWeight="Bold" Foreground="#1F2D3D" TextAlignment="Center" />
                                <myplc:PlcRangeIndicator Canvas.Left="390" Canvas.Top="87" Width="16" Height="16" TagName="小车实际位置" TagAddress="DB1.DBW240" DataType="UInt16" Condition="Equal" CompareValue="28" TrueBrush="#67C23A" FalseBrush="#F56C6C" Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                                <myplc:PlcNumericInput Canvas.Left="412" Canvas.Top="47" Width="112" Height="40" Label="降速时间" TagName="降速时间29" TagAddress="DB1.DBW302" DataType="Int16" FormatString="F0" Unit="100ms" Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <myplc:PlcSelectButton Canvas.Left="368" Canvas.Top="113" Width="60" Height="26" ButtonText="选定" WriteValue="28" WriteTagAddress="DB1.DBW250" WriteTagName="小车设定位置" HorizontalAlignment="Center" Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
                                <Ellipse Canvas.Left="536" Canvas.Top="79" Width="32" Height="32" Fill="#16324A" Stroke="#00E5FF" StrokeThickness="2.5" />
                                <TextBlock Canvas.Left="512" Canvas.Top="31" Width="80" Text="2号位" FontSize="12" FontWeight="Bold" Foreground="#1F2D3D" TextAlignment="Center" />
                                <myplc:PlcRangeIndicator Canvas.Left="544" Canvas.Top="87" Width="16" Height="16" TagName="小车实际位置" TagAddress="DB1.DBW240" DataType="UInt16" Condition="Equal" CompareValue="30" TrueBrush="#67C23A" FalseBrush="#F56C6C" Connection="{Binding RelativeSource={RelativeSource AncestorType=myplc:PlcPanel}, Path=Connection}" />
