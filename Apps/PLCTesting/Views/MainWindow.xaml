                </Grid.ColumnDefinitions>
                <!-- 左侧控制按钮 -->
                <myplc:PlcPanel Grid.Column="0" Header="🎮 运动控制台" Connection="{Binding Connection}" Margin="0,0,12,0" MinHeight="105" VerticalAlignment="Stretch">
                    <myplc:PlcPanel.PanelContent>
                        <StackPanel Margin="1">
                            <TextBlock Text="⚡ 点动控制" Style="{StaticResource GroupTitle}" />
                            <WrapPanel Margin="0,0,0,4">
                                <myplc:PlcButton Margin="0,0,8,0" Width="72" Height="24"
                                                     Connection="{Binding Connection}" Mode="Momentary"
                                                     ControlTagAddress="DB1.DBX6.1" StatusTagAddress="DB1.DBX6.1"
                                                     OnContent="正向点动" OffContent="正向点动"
                                                     OnBrush="#67C23A" OffBrush="#909399"
                                                     ControlTagName="启动控制(ON)" StatusTagName="运行状态" />
                                <myplc:PlcButton Width="72" Height="24"
                                                     Connection="{Binding Connection}" Mode="Momentary"
                                                     ControlTagAddress="DB1.DBX6.2" StatusTagAddress="DB1.DBX6.2"
                                                     OnContent="反向点动" OffContent="反向点动"
                                                     OnBrush="#67C23A" OffBrush="#909399"
                                                     ControlTagName="启动控制(ON)1" StatusTagName="运行状态1" />
                            </WrapPanel>
                            <TextBlock Text="🔘 启停控制" Style="{StaticResource GroupTitle}" />
                            <WrapPanel>
                                <myplc:PlcButton Margin="0,0,8,0" Width="72" Height="24"
                                                     Connection="{Binding Connection}" Mode="Toggle"
                                                     ControlTagAddress="DB1.DBX6.1" StatusTagAddress="DB1.DBX6.1"
                                                     OnContent="停止" OffContent="正向启动"
                                                     OnBrush="#67C23A" OffBrush="#909399"
                                                     ControlTagName="正向点动" StatusTagName="正向点动" />
                                <myplc:PlcButton Width="72" Height="24"
                                                     Connection="{Binding Connection}" Mode="Toggle"
                                                     ControlTagAddress="DB1.DBX6.2" StatusTagAddress="DB1.DBX6.2"
                                                     OnContent="停止" OffContent="反向启动"
                                                     OnBrush="#67C23A" OffBrush="#909399"
                                                     ControlTagName="反向点动" StatusTagName="反向点动" />
                            </WrapPanel>
                            <TextBlock Text="💡 点击按钮发送指令" FontSize="9" Foreground="#909399" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </myplc:PlcPanel.PanelContent>
                </myplc:PlcPanel>
                <!-- 右侧趋势曲线（启用新库 Title/Unit/SmoothCurve/ShowArea/ShowStats） -->
                <myplc:PlcPanel Grid.Column="1" Header="📈 实际速度趋势" Connection="{Binding Connection}" VerticalAlignment="Stretch">
                    <myplc:PlcPanel.PanelContent>
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <myplc:PlcTrendControl Grid.Row="0" Connection="{Binding Connection}" Width="300" Height="160"
                                                     TagAddress="DB1.DBD1012" DataType="Float"
                                                     SamplingInterval="200" MaxDataPoints="100"
                                                     StrokeBrush="#409EFF" StrokeThickness="2"
                                                     Title="实际速度趋势" Unit="度/秒"
                                                     SmoothCurve="True" ShowArea="True"
                                                     ShowStats="True" Margin="138,4,614,7" Grid.RowSpan="2"  />
                            <TextBlock Grid.Row="1" Text="采样 200ms，自动 Y 轴，100 点" FontSize="8" Foreground="#909399"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </Grid>
                    </myplc:PlcPanel.PanelContent>
                </myplc:PlcPanel>
            </Grid>
        </Grid>
        <!-- 底部状态栏（科技渐变 + 顶部青色辉光线） -->
        <Border Grid.Row="2" Background="{StaticResource TechBarBrush}">
            <Grid>
                <!-- 顶部青色辉光强调线 -->
                <Border Height="1" VerticalAlignment="Top" Background="{StaticResource TechCyanBrush}" Opacity="0.6" />
                <StackPanel Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center">
                    <TextBlock Text="版本: v1.0.0" FontSize="11" Foreground="{StaticResource TechTextDim}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="14" Fill="#2A4A63" Margin="12,0" VerticalAlignment="Center" />
                    <TextBlock Text="© 2025 骨料巡检机器人系统" FontSize="11" Foreground="{StaticResource TechTextDim}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="14" Fill="#2A4A63" Margin="12,0" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" Fill="{StaticResource TechCyanBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                             Effect="{StaticResource TechGlow}" />
                    <TextBlock Text="系统运行中" FontSize="11" Foreground="#B7D4EC" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
