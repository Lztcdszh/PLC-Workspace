<Window x:Class="PLCTesting.Views.MqttConfigView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PLCTesting.Views"
        Title="MQTT 转发配置"
        Width="520"
        Height="700"
        MinHeight="600"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        Background="{StaticResource AppPageBg}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 连接状态点：绿=已连，灰=未连（深色主题下未连用中灰，纯浅灰会过亮） -->
        <local:BoolToBrushConverter x:Key="BoolToBrush" TrueBrush="#67C23A" FalseBrush="#6E6E6E" />
        <!-- 运行态 → 按钮文案 -->
        <local:BoolToTextConverter x:Key="RunLabel" TrueText="⏹ 停止转发" FalseText="▶ 启动转发" />
        <!-- 勾选 TLS 后才展开证书配置区 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="20,18,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 页头 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Style="{StaticResource PageTitleIcon}">
                <TextBlock Text="📡" FontSize="16" Foreground="{StaticResource AppAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MQTT 转发" Style="{StaticResource TxtPageTitle}" />
                <TextBlock Text="把启用的数据点推送到 Broker" Style="{StaticResource TxtSubtitle}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- ===== 内容 ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 运行状态 -->
                <TextBlock Text="运行状态" Style="{StaticResource TxtSection}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 第一行：状态 + 主操作 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{Binding Service.IsConnected, Converter={StaticResource BoolToBrush}}" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppText}">
                                    <Run Text="{Binding Service.StatusText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource BtnSecondary}"
                                    Content="{Binding Service.IsRunning, Converter={StaticResource RunLabel}}"
                                    Command="{Binding TogglePublishCommand}" />
                        </Grid>

                        <!-- 统计 -->
                        <Border Style="{StaticResource HintBar}" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TxtCaption}">
                                    <Run Text="已发布" /><Run Text=" " />
                                    <Run Text="{Binding Service.PublishedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AppText}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource TxtCaption}" Margin="16,0,0,0">
                                    <Run Text="定时轮次" /><Run Text=" " />
                                    <Run Text="{Binding Service.PeriodicRoundCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AppText}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource TxtCaption}" Margin="16,0,0,0">
                                    <Run Text="最近发布" /><Run Text=" " />
                                    <Run Text="{Binding Service.LastPublishTimeText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AppText}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 开关 + 立即发布 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="启用 MQTT 转发" VerticalAlignment="Center"
                                      IsChecked="{Binding Config.Enabled}" />
                            <Button Grid.Column="1" Content="立即发布一次" Style="{StaticResource BtnSuccess}"
                                    Padding="10,5" Command="{Binding PublishNowCommand}"
                                    IsEnabled="{Binding Service.IsConnected, Mode=OneWay}" />
                        </Grid>

                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource AppWarning}"
                                   TextWrapping="Wrap" Text="{Binding Service.LastError, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Broker -->
                <TextBlock Text="Broker 连接" Style="{StaticResource TxtSection}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="服务器地址" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding Config.BrokerHost, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Grid.Row="1" Grid.Column="0" Content="端口" />
                        <TextBox Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"
                                 Text="{Binding Config.BrokerPort, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Grid.Row="2" Grid.Column="0" Content="主题前缀" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding Config.BaseTopic, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <!-- 加密传输（TLS） -->
                <TextBlock Text="加密传输（TLS）" Style="{StaticResource TxtSection}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                      Content="启用 TLS 加密上传"
                                      IsChecked="{Binding UseTls}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Style="{StaticResource TxtCaption}"
                                       Text="{Binding TlsSummary}" />
                        </Grid>

                        <StackPanel Visibility="{Binding TlsOptionsVisible, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource HintBar}" Margin="0,10,0,12">
                                <TextBlock Style="{StaticResource TxtCaption}" TextWrapping="Wrap"
                                           Text="端口一般改成 8883。Broker 用自签名证书时，请在这里指定它的 CA 证书；若证书里的域名与实际连接地址不同（IP 直连或内网穿透），在「校验主机名」填证书签发的那个域名即可，不必关闭校验。" />
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="CA 证书" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,6,10"
                                         Text="{Binding CaCertPath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="自签名证书必填；留空则使用操作系统信任库" />
                                <Button Grid.Row="0" Grid.Column="2" Content="浏览" MinWidth="58" Margin="0,0,0,10"
                                        Style="{StaticResource BtnSecondary}"
                                        Command="{Binding BrowseCaCertCommand}" />

                                <Label Grid.Row="1" Grid.Column="0" Content="客户端证书" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,6,10"
                                         Text="{Binding ClientCertPath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="双向认证（mTLS）才需要，通常为 .pfx / .p12" />
                                <Button Grid.Row="1" Grid.Column="2" Content="浏览" MinWidth="58" Margin="0,0,0,10"
                                        Style="{StaticResource BtnSecondary}"
                                        Command="{Binding BrowseClientCertCommand}" />

                                <Label Grid.Row="2" Grid.Column="0" Content="证书密码" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,6,10"
                                         Text="{Binding ClientCertPassword, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip=".pfx / .p12 有密码时填写，没有就留空" />

                                <Label Grid.Row="3" Grid.Column="0" Content="校验主机名" />
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                         Text="{Binding TlsTargetHost, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="留空 = 用服务器地址校验。证书域名与实际连接地址不一致时填证书里的域名" />
                            </Grid>

                            <CheckBox Margin="0,12,0,0"
                                      IsChecked="{Binding AllowUntrustedCert}"
                                      Content="跳过服务端证书校验（仅联调使用）"
                                      ToolTip="通道仍然加密，但不验证对端身份，无法防中间人攻击。生产环境请改用正确的 CA 证书。">
                                <!-- 只在勾选后才变成警示色：常驻橙色会让人误以为已经启用了这个危险选项 -->
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllowUntrustedCert}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AppWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 发布方式 -->
                <TextBlock Text="发布方式" Style="{StaticResource TxtSection}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox Content="变化时发布 —— 标签值一变就发一帧"
                                  IsChecked="{Binding PublishOnChange}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox VerticalAlignment="Center"
                                      Content="定时发布 —— 按周期把全部启用点重发一遍"
                                      IsChecked="{Binding PublishPeriodic}" />
                            <TextBox Width="62" Margin="12,0,6,0" TextAlignment="Right"
                                     Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="秒 / 次" VerticalAlignment="Center" Style="{StaticResource TxtCaption}" />
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0" Style="{StaticResource TxtCaption}" TextWrapping="Wrap"
                                   LineHeight="18" Text="{Binding ModeHint}" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,0,0,12" Style="{StaticResource TxtCaption}" TextWrapping="Wrap" LineHeight="18"
                           Text="转发 dataPoints.json 中「启用 MQTT 发布」的点，QoS 1。主题格式：&lt;前缀&gt;/&lt;PLC地址&gt;。周期最小 0.2 秒、最大 3600 秒。" />

            </StackPanel>
        </ScrollViewer>

        <!-- ===== 页脚 ===== -->
        <Border Grid.Row="2" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,1,0,0"
                Padding="0,12,0,14" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource TxtCaption}"
                           Text="{Binding TestResult}" TextWrapping="Wrap" Margin="0,0,12,0" />
                <Button Grid.Column="1" Content="测试连接" Style="{StaticResource BtnSecondary}"
                        Margin="0,0,8,0" Command="{Binding TestCommand}" />
                <Button Grid.Column="2" Content="保存配置" Style="{StaticResource BtnPrimary}"
                        Padding="20,7" Command="{Binding SaveCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
