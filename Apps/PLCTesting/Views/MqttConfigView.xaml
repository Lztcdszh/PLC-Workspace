<Window x:Class="PLCTesting.Views.MqttConfigView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PLCTesting.Views"
        xmlns:myplc="clr-namespace:MyPLCUserControlLibrary;assembly=MyPLCUserControlLibrary"
        Title="MQTT 转发配置"
        Width="560"
        Height="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        Background="#E8ECF0">

    <Window.Resources>
        <!-- 连接状态点：绿=已连，灰=未连 -->
        <local:BoolToBrushConverter x:Key="BoolToBrush"
                                    TrueBrush="#67C23A" FalseBrush="#C0C4CC" />
        <!-- 运行态 → 按钮文案 -->
        <local:BoolToTextConverter x:Key="RunLabel"
                                   TrueText="⏹ 停止转发" FalseText="▶ 启动转发" />

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#409EFF" />
            <Setter Property="Margin" Value="0,4,0,6" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#409EFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="#333" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1A2A3A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📡" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="MQTT 转发配置" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 可滚动主体 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 状态卡片 -->
                <Border Background="#F2F6FC" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Ellipse Grid.Row="0" Grid.Column="0" Width="12" Height="12" Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Service.IsConnected, Converter={StaticResource BoolToBrush}}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Bold">
                            <Run Text="转发状态：" />
                            <Run Text="{Binding Service.StatusText, Mode=OneWay}" />
                        </TextBlock>
                        <Button Grid.Row="0" Grid.Column="2" Content="{Binding Service.IsRunning, Converter={StaticResource RunLabel}}"
                                Style="{StaticResource AccentButton}" Command="{Binding TogglePublishCommand}" />

                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock FontSize="11" Foreground="#666">
                                <Run Text="已发布消息：" />
                                <Run Text="{Binding Service.PublishedCount, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                            <CheckBox Content="启用 MQTT 转发" Margin="20,0,0,0" FontSize="11"
                                      IsChecked="{Binding Config.Enabled}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                   FontSize="10" Foreground="#E6A23C" TextWrapping="Wrap"
                                   Text="{Binding Service.LastError, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- Broker 设置 -->
                <TextBlock Text="① Broker 连接" Style="{StaticResource GroupTitle}" />
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="服务器地址" />
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Config.BrokerHost, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Grid.Row="1" Grid.Column="0" Content="端口" />
                        <TextBox Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                 Text="{Binding Config.BrokerPort, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="1" Grid.Column="2" Content="ClientId" />
                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Text="{Binding Config.ClientId, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Grid.Row="2" Grid.Column="0" Content="用户名" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Config.Username, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Grid.Row="3" Grid.Column="0" Content="密码" />
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Config.Password, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                  Content="使用 TLS 加密连接 (8883 等)" FontSize="11"
                                  IsChecked="{Binding Config.UseTls}" />
                    </Grid>
                </Border>

                <!-- 主题与消息 -->
                <TextBlock Text="② 主题与消息格式" Style="{StaticResource GroupTitle}" />
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="基础主题" />
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Config.BaseTopic, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Grid.Row="1" Grid.Column="0" Content="主题命名" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding TopicFormatOptions}"
                                  SelectedValue="{Binding Config.TopicFormat}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label" />

                        <Label Grid.Row="1" Grid.Column="2" Content="QoS" />
                        <ComboBox Grid.Row="1" Grid.Column="3"
                                  ItemsSource="{Binding QosOptions}"
                                  SelectedValue="{Binding Config.Qos}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label" />

                        <Label Grid.Row="2" Grid.Column="0" Content="消息格式" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center"
                                   FontSize="10" Foreground="#666" TextWrapping="Wrap">
                            JSON：{"tag":"名称","address":"地址","value":"值","ts":"时间"}
                        </TextBlock>

                        <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                  Content="保留最后消息 (Retain)" FontSize="11"
                                  IsChecked="{Binding Config.Retain}" />
                    </Grid>
                </Border>

                <!-- 发布设置 -->
                <TextBlock Text="③ 发布策略" Style="{StaticResource GroupTitle}" />
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="发布模式" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding PublishModeOptions}"
                                  SelectedValue="{Binding Config.PublishMode}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label" />
                        <Label Grid.Row="0" Grid.Column="2" Content="间隔(ms)" />
                        <TextBox Grid.Row="0" Grid.Column="3"
                                 Text="{Binding Config.PublishIntervalMs, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,0"
                                   FontSize="10" Foreground="#666" TextWrapping="Wrap">
                            「值变化即发布」：标签值改变时即时推送；「周期性发布」：按间隔推送全部选中标签当前值。
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 标签选择 -->
                <TextBlock Text="④ 发布标签" Style="{StaticResource GroupTitle}" />
                <Border Background="White" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <CheckBox Content="发布全部已注册标签" FontSize="11" FontWeight="Bold"
                                  IsChecked="{Binding PublishAllTags}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <Button Content="全选" FontSize="10" Padding="10,3" Margin="0,0,6,0"
                                    Command="{Binding SelectAllCommand}" />
                            <Button Content="全不选" FontSize="10" Padding="10,3"
                                    Command="{Binding SelectNoneCommand}" />
                            <TextBlock Text="（取消上方勾选后可单独选择）" FontSize="10" Foreground="#999"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding AvailableTags}" MaxHeight="190"
                                 IsEnabled="{Binding TagsSelectable}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" FontSize="11" Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Width="130"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Address}" Foreground="Gray" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#1A2A3A" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="#BDC3C7"
                           Text="{Binding TestResult}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="🔌 测试连接" Style="{StaticResource AccentButton}"
                        Background="#E6A23C" Margin="0,0,8,0" Command="{Binding TestCommand}" />
                <Button Grid.Column="2" Content="💾 保存配置" Style="{StaticResource AccentButton}"
                        Command="{Binding SaveCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
