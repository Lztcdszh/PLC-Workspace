<Window x:Class="PLCTesting.Views.MqttConfigView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PLCTesting.Views"
        Title="MQTT 转发配置"
        Width="470"
        Height="620"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        Background="#E8ECF0">

    <Window.Resources>
        <!-- 连接状态点：绿=已连，灰=未连 -->
        <local:BoolToBrushConverter x:Key="BoolToBrush"
                                    TrueBrush="#67C23A" FalseBrush="#C0C4CC" />
        <!-- 运行态 → 按钮文案 -->
        <local:BoolToTextConverter x:Key="RunLabel"
                                   TrueText="⏹ 停止转发" FalseText="▶ 启动转发" />

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#409EFF" />
            <Setter Property="Margin" Value="0,4,0,6" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#409EFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 小号动作按钮：自绘模板，避免系统主题把禁用态刷成白底白字（"立即发布一次" 曾不可见） -->
        <Style x:Key="MiniActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#67C23A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7FD04A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE6D6" />
                                <Setter Property="Foreground" Value="#93A38B" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="#333" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1A2A3A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📡" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="MQTT 转发配置" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 主体 -->
        <StackPanel Grid.Row="1">
            <!-- 状态卡片 -->
            <Border Background="#F2F6FC" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Ellipse Grid.Row="0" Grid.Column="0" Width="12" Height="12" Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{Binding Service.IsConnected, Converter={StaticResource BoolToBrush}}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Bold">
                        <Run Text="转发状态：" />
                        <Run Text="{Binding Service.StatusText, Mode=OneWay}" />
                    </TextBlock>
                    <Button Grid.Row="0" Grid.Column="2" Content="{Binding Service.IsRunning, Converter={StaticResource RunLabel}}"
                            Style="{StaticResource AccentButton}" Command="{Binding TogglePublishCommand}" />

                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock FontSize="11" Foreground="#666">
                            <Run Text="已发布消息：" />
                            <Run Text="{Binding Service.PublishedCount, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#666" Margin="14,0,0,0">
                            <Run Text="定时轮次：" />
                            <Run Text="{Binding Service.PeriodicRoundCount, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#666" Margin="14,0,0,0">
                            <Run Text="最近发布：" />
                            <Run Text="{Binding Service.LastPublishTimeText, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox Content="启用 MQTT 转发" FontSize="11" VerticalAlignment="Center"
                                  IsChecked="{Binding Config.Enabled}" />
                        <Button Content="📤 立即发布一次" Margin="14,0,0,0"
                                Style="{StaticResource MiniActionButton}"
                                Command="{Binding PublishNowCommand}"
                                IsEnabled="{Binding Service.IsConnected, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                               FontSize="10" Foreground="#E6A23C" TextWrapping="Wrap"
                               Text="{Binding Service.LastError, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- Broker 连接 -->
            <TextBlock Text="Broker 连接" Style="{StaticResource GroupTitle}" />
            <Border Background="White" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="服务器地址" />
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                             Text="{Binding Config.BrokerHost, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Grid.Row="1" Grid.Column="0" Content="端口" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                             Text="{Binding Config.BrokerPort, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Grid.Row="2" Grid.Column="0" Content="主题前缀" />
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                             Text="{Binding Config.BaseTopic, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <!-- 发布方式 -->
            <TextBlock Text="⏱ 发布方式" Style="{StaticResource GroupTitle}" Margin="0,10,0,6" />
            <Border Background="White" CornerRadius="6" Padding="12">
                <StackPanel>
                    <CheckBox FontSize="11" Content="变化时发布 —— 标签值一变就发一帧"
                              IsChecked="{Binding PublishOnChange}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox FontSize="11" VerticalAlignment="Center"
                                  Content="定时发布 —— 按周期把全部启用点重发一遍"
                                  IsChecked="{Binding PublishPeriodic}" />
                        <TextBox Width="58" Margin="12,0,4,0" TextAlignment="Right" Padding="4,2"
                                 Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="秒 / 次" FontSize="11" VerticalAlignment="Center" Foreground="#666" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="#909399" TextWrapping="Wrap"
                               Text="{Binding ModeHint}" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,10,0,0" FontSize="10" Foreground="#999" TextWrapping="Wrap">
                转发 dataPoints.json 中「启用 MQTT 发布」的点，QoS 1。主题格式：&lt;前缀&gt;/&lt;PLC地址&gt;。
                周期最小 0.2 秒、最大 3600 秒。
            </TextBlock>
        </StackPanel>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#1A2A3A" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="#BDC3C7"
                           Text="{Binding TestResult}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="🔌 测试连接" Style="{StaticResource AccentButton}"
                        Background="#E6A23C" Margin="0,0,8,0" Command="{Binding TestCommand}" />
                <Button Grid.Column="2" Content="💾 保存配置" Style="{StaticResource AccentButton}"
                        Command="{Binding SaveCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
