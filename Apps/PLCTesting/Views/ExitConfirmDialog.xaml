<Window x:Class="PLCTesting.Views.ExitConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭确认"
        Height="210" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- 科技风按钮模板 -->
        <Style x:Key="TechDlgButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="#33FFFFFF" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.85" Color="#00E5FF" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#AAF0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层圆角深色科技卡片 -->
    <Border CornerRadius="12" BorderThickness="1" BorderBrush="#1E4A6E" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0E2036" Offset="0" />
                <GradientStop Color="#123048" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 + 青色辉光图标 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="⏻" FontSize="18" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.8" Color="#00E5FF" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="关闭 PLCTesting" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                       LineHeight="21" Foreground="#B7D4EC"
                       Text="选择「后台运行」会缩小到系统托盘，MQTT 仍持续发布；选择「退出程序」将完全结束进程。" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="BtnTray" Content="后台运行" Width="100" Height="34" Margin="0,0,10,0"
                        Background="#2B7FE0" Style="{StaticResource TechDlgButton}"
                        Click="BtnTray_Click" />
                <Button x:Name="BtnExit" Content="退出程序" Width="100" Height="34"
                        Background="#E05561" Style="{StaticResource TechDlgButton}"
                        Click="BtnExit_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
