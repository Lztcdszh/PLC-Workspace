<Window x:Class="PLCTesting.Views.ExitConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭确认"
        Height="220" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        UseLayoutRounding="True">

    <!-- 圆角浅色卡片：与主窗口一致的白卡 + 细边，不再用深色渐变与辉光 -->
    <Border CornerRadius="12" Background="{StaticResource AppSurface}"
            BorderBrush="{StaticResource AppBorder}" BorderThickness="1" Margin="8">
        <Grid Margin="22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Style="{StaticResource PageTitleIcon}" Width="30" Height="30" Margin="0,0,10,0">
                    <TextBlock Text="⏻" FontSize="15" Foreground="{StaticResource AppAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="关闭 PLCTesting" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource AppText}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                       LineHeight="21" Foreground="{StaticResource AppTextSub}"
                       Text="选择「后台运行」会缩小到系统托盘，MQTT 仍持续发布；选择「退出程序」将完全结束进程。" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnTray" Content="后台运行" Width="104" Height="34"
                        Style="{StaticResource BtnSecondary}" Click="BtnTray_Click" />
                <Button x:Name="BtnExit" Content="退出程序" Width="104" Height="34" Margin="10,0,0,0"
                        Style="{StaticResource BtnDanger}" Click="BtnExit_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
