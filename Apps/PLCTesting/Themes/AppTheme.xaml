<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ============================================================================
      PLCTesting 全局视觉主题（v1.2.0 现代深色改版）
      ============================================================================
      设计原则：
      1) 色值只在这里定义一次，且与 MyPLCUserControlLibrary/Themes/PlcStyles.xaml
         的 Element 调色板完全一致 —— 窗口自绘部分与 PlcPanel / PlcValueDisplay /
         PlcTrendControl 等控件天然同色，不会出现"两种蓝"。
      2) 现代深灰层次：页面底最深（#141414），卡片浮起（#1F1F1F），输入框与表头
         再亮一档（#262626），细边框（#303030 / #434343）分层。不用渐变、不用辉光、
         不用投影（DropShadowEffect 在高分屏离屏渲染时会把整窗位图拉伸发糊）。
      3) 语义化命名（Txt* / Btn* / Card*），各窗口只引用，不各自定义颜色。
      4) 令牌名与 1.1.9 完全一致，仅颜色值翻转 —— 各窗口 XAML 无需改动即可变深色。
      ============================================================================
    -->

    <!-- ===== 语义色（深色） ===== -->
    <SolidColorBrush x:Key="AppPageBg" Color="#141414" />
    <SolidColorBrush x:Key="AppSurface" Color="#1F1F1F" />
    <SolidColorBrush x:Key="AppSurfaceAlt" Color="#262626" />
    <SolidColorBrush x:Key="AppBorder" Color="#303030" />
    <SolidColorBrush x:Key="AppBorderStrong" Color="#4A4A4A" />

    <SolidColorBrush x:Key="AppText" Color="#E8E8E8" />
    <SolidColorBrush x:Key="AppTextSub" Color="#B0B0B0" />
    <SolidColorBrush x:Key="AppTextFaint" Color="#7A7A7A" />

    <SolidColorBrush x:Key="AppAccent" Color="#409EFF" />
    <SolidColorBrush x:Key="AppAccentSoft" Color="#1B3350" />
    <SolidColorBrush x:Key="AppSuccess" Color="#67C23A" />
    <SolidColorBrush x:Key="AppSuccessSoft" Color="#1E3312" />
    <SolidColorBrush x:Key="AppWarning" Color="#E6A23C" />
    <SolidColorBrush x:Key="AppWarningSoft" Color="#3A2A12" />
    <SolidColorBrush x:Key="AppDanger" Color="#F56C6C" />
    <SolidColorBrush x:Key="AppDangerSoft" Color="#3A1A1A" />

    <!-- 深色专用：交互高亮层（白色半透明叠加，对所有底色都表现为"更亮"）与文本选区 -->
    <SolidColorBrush x:Key="AppHoverVeil" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppSelection" Color="#55409EFF" />
    <SolidColorBrush x:Key="AppInputBg" Color="#262626" />
    <SolidColorBrush x:Key="AppRowAlt" Color="#232323" />

    <!-- ===== 文字层级 ===== -->
    <Style x:Key="TxtPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TxtSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AppTextFaint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TxtSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="TxtBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AppTextSub}" />
    </Style>

    <Style x:Key="TxtCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource AppTextFaint}" />
    </Style>

    <!-- 页面标题行：左侧色块 + 图标 + 标题 + 副标题（各窗口统一用它做头部） -->
    <Style x:Key="PageTitleIcon" TargetType="Border">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{StaticResource AppAccentSoft}" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- ===== 卡片 ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CardTight" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- 提示条：深一档的底 + 细边 -->
    <Style x:Key="HintBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppSurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- ===== 按钮 ===== -->
    <!--
      深色下的交互反馈：不再用整体 Opacity 降透明度（深色背景叠深色按钮会越按越糊），
      改为在按钮内部叠一层白色半透明"高亮层"：hover 7%、press 15%，
      对灰底/蓝底/绿底/红底一律表现为"更亮一档"；disabled 才用 Opacity 0.45。
    -->
    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppSurfaceAlt}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextSub}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- 高亮层先入树，内容后入树，保证文字永远压在高亮层之上 -->
                            <Border x:Name="Hl"
                                    CornerRadius="5"
                                    Background="{StaticResource AppHoverVeil}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter x:Name="Cp"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hl" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hl" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter TargetName="Hl" Property="Opacity" Value="0" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主操作：填充强调蓝，一屏最多一个 -->
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource AppAccent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource AppAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 次操作：深灰底细边，用于工具栏与对话框"取消" -->
    <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource AppSurfaceAlt}" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrong}" />
    </Style>

    <!-- 轻量：无边框，用于行内的文字型操作 -->
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AppTextSub}" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource AppSuccess}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource AppSuccess}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BtnWarning" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource AppWarning}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource AppWarning}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource AppDanger}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDanger}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 小号：卡片内页脚、表格行操作 -->
    <Style x:Key="BtnSm" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- ===== 输入控件 ===== -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="Background" Value="{StaticResource AppInputBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource AppText}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AppSelection}" />
        <Setter Property="SelectionTextBrush" Value="{StaticResource AppText}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5A5A" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppSurface}" />
                            <Setter Property="Foreground" Value="{StaticResource AppTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ComboBox：默认模板的下拉 Popup 在独立视觉树里，取的是系统 WindowBrush（白底），
      深色下必然是"白底黑字"的突兀块，所以这里自绘完整模板（含 PART_EditableTextBox
      与 PART_Popup），保证编辑态与下拉列表都跟随深色令牌。
    -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="4"
                            Margin="3,1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppSurfaceAlt}" />
                            <Setter Property="Foreground" Value="{StaticResource AppText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource AppAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="Background" Value="{StaticResource AppInputBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True" />

                        <!-- 展开按钮放在内容层之下：右侧 26px 空白区留给它接点击，中间内容区不遮挡文字 -->
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" SnapsToDevicePixels="True">
                                        <Path x:Name="Arrow"
                                              Width="8" Height="5"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Data="M0,0 L8,0 L4,5 Z"
                                              Fill="{StaticResource AppTextFaint}" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          Margin="9,0,26,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{x:Null}"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource AppText}"
                                 CaretBrush="{StaticResource AppText}"
                                 SelectionBrush="{StaticResource AppSelection}"
                                 FontSize="{TemplateBinding FontSize}"
                                 VerticalContentAlignment="Center"
                                 Margin="7,0,24,0"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border x:Name="DropDown"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,2,0,0"
                                    Padding="1"
                                    CornerRadius="6"
                                    Background="{StaticResource AppSurface}"
                                    BorderBrush="{StaticResource AppBorderStrong}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter TargetName="ToggleButton" Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 复选框：默认方块取系统浅色，深色下会变成刺眼白块，因此自绘方块 -->
    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AppTextSub}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Grid.Column="0"
                                Width="15" Height="15"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="{StaticResource AppInputBg}"
                                BorderBrush="{StaticResource AppBorderStrong}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Width="9" Height="7"
                                  Stretch="Fill"
                                  Visibility="Collapsed"
                                  Data="M0,3 L3.2,6.2 L9,0.4"
                                  Stroke="{StaticResource AppAccent}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Border>
                        <ContentPresenter x:Name="Cp"
                                          Grid.Column="1"
                                          Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AppAccentSoft}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      DataGridCheckBoxColumn 会用自己的 ElementStyle 覆盖隐式 CheckBox 样式，
      深色表格里就会露出系统白方块。这两个列显式引用本样式即可保持一致。
    -->
    <Style x:Key="GridCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AppTextSub}" />
        <Setter Property="Padding" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <!--
      日历弹出层：独立 Popup，是"白底黑字"的高发区。
      DatePicker 内部的 Calendar 走的是 DatePicker.CalendarStyle 显式赋值，
      在 Popup 里解析不到隐式样式，所以这里用带 x:Key 的样式并由 DatePicker 显式引用。
      Calendar 自身模板里的外框是 Aero 写死的浅色，必须换成只含
      PART_Root + PART_CalendarItem 的最小模板。
    -->
    <Style x:Key="AppCalendarItemStyle" TargetType="CalendarItem">
        <Setter Property="Background" Value="{StaticResource AppSurface}" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="AppCalendarDayButtonStyle" TargetType="CalendarDayButton">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                            Padding="3,1" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppSurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AppTextFaint}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccent}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppCalendarButtonStyle" TargetType="CalendarButton">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="Background" Value="{StaticResource AppSurface}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="AppCalendarStyle" TargetType="Calendar">
        <Setter Property="Background" Value="{StaticResource AppSurface}" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrong}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource AppCalendarItemStyle}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource AppCalendarDayButtonStyle}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource AppCalendarButtonStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">

                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <StackPanel x:Name="PART_Root">
                            <CalendarItem x:Name="PART_CalendarItem"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          Style="{TemplateBinding CalendarItemStyle}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Calendar" BasedOn="{StaticResource AppCalendarStyle}" />

    <!-- ===== 日期选择 ===== -->
    <!--
      DatePicker 的默认模板（Aero）内部白底是写死在外观模板里的，只改 Background/ Foreground
      改不动，深色下会成为一块刺眼的白砖。这里自绘模板，只保留 WPF 要求的四个部件：
      PART_Root / PART_TextBox / PART_Button / PART_Popup。
    -->
    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="Background" Value="{StaticResource AppInputBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CalendarStyle" Value="{StaticResource AppCalendarStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Bd"
                                Grid.ColumnSpan="2"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True" />

                        <DatePickerTextBox x:Name="PART_TextBox"
                                           Grid.Column="0"
                                           Margin="1,0,0,0"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           Foreground="{StaticResource AppText}"
                                           CaretBrush="{StaticResource AppText}"
                                           SelectionBrush="{StaticResource AppSelection}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Padding="6,4"
                                           VerticalContentAlignment="Center" />

                        <Button x:Name="PART_Button" Grid.Column="1" Width="26"
                                Focusable="False" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <TextBlock Text="▾" FontSize="11"
                                                   Foreground="{StaticResource AppTextFaint}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               StaysOpen="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePickerTextBox">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{StaticResource AppText}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AppSelection}" />
        <Setter Property="SelectionTextBrush" Value="{StaticResource AppText}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="CalendarDayButton">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="3,1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppSurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccent}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AppTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CalendarButton">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="Background" Value="{StaticResource AppSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrong}" />
    </Style>

    <!-- ===== 表格 ===== -->
    <Style TargetType="DataGrid">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{StaticResource AppSurface}" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="{StaticResource AppSurface}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource AppRowAlt}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource AppSurfaceAlt}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextSub}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 行级状态：默认模板的选中行会刷系统高亮蓝，这里压成深色语义（不设 Background，避免盖掉交替行色） -->
    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AppSurfaceAlt}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AppAccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource AppText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AppAccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource AppText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      滚动条保持系统默认样式：自绘 Track 模板要正确处理 Orientation / 双向 ScrollBar
      的 IsDirectionReversed，一旦写错会让表格与滚动面板"滚不动"，收益远小于风险。
    -->

</ResourceDictionary>
