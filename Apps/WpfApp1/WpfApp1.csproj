<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WpfApp1</AssemblyName>
    <RootNamespace>WpfApp1</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Kitware.mummy.Runtime">
      <HintPath>dll\Kitware.mummy.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Kitware.VTK">
      <HintPath>dll\Kitware.VTK.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.1.873" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.26" />
  </ItemGroup>

  <Target Name="CopyDlls" BeforeTargets="CoreCompile">
    <ItemGroup>
      <FilesToCopy Include=".\dll\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(OutputPath)\%(RecursiveDir)" />
  </Target>

  <Target Name="CopyFilesOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <FilesToCopy Include=".\dll\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(PublishDir)\%(RecursiveDir)" />
  </Target>

</Project>
