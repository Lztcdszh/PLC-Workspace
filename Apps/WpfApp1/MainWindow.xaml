<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="VTK 点云可视化" Height="760" Width="1240"
        Background="#F3F4F6"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- 调色板 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F8FAFC"/>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.10" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（工具栏） -->
        <Style x:Key="ToolBarButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级按钮（面板内） -->
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 区块标题 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <!-- 折叠面板标题 -->
        <Style x:Key="ModernExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 下拉框 -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 列表项悬停/选中 -->
        <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 隐式样式：文本框 / 滑块 / 复选框 -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#2563EB"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Width" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：品牌栏 + 工具栏 -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 品牌栏 -->
            <Border Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="14,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFFFFF" Opacity="0.18" CornerRadius="7" Width="28" Height="28"
                            VerticalAlignment="Center" Margin="0,0,11,0">
                        <TextBlock Text="3D" Foreground="White" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="点云可视化工作台" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="VTK · 多点点云 · 体积计算 · 数据库 · MQTT" Foreground="#DBEAFE" FontSize="10.5" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 工具栏 -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Vertical">
                    <!-- 第一行：文件操作 + 视图操作 -->
                    <StackPanel Orientation="Horizontal" Margin="10,7">
                        <TextBlock Text="文件" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="#2563EB"/>
                        <Button x:Name="BtnImportPly" Style="{StaticResource ToolBarButton}" Content="导入 PLY" Click="ImportPly_Click"/>
                        <Button x:Name="BtnImportPcd" Style="{StaticResource ToolBarButton}" Content="导入 PCD" Click="ImportPcd_Click"/>
                        <Separator Width="8"/>
                        <Button x:Name="BtnGenerate" Style="{StaticResource ToolBarButton}" Content="生成示例点云" Click="GenerateSample_Click"/>
                        <Button x:Name="BtnRemoveCloud" Style="{StaticResource ToolBarButton}" Content="删除选中" Click="RemoveCloud_Click"/>
                        <Button x:Name="BtnClearAll" Style="{StaticResource ToolBarButton}" Content="清空全部" Click="ClearAll_Click"/>
                        <Button x:Name="BtnReset" Style="{StaticResource ToolBarButton}" Content="重置视角" Click="ResetView_Click"/>

                        <Separator Width="16"/>
                        <TextBlock Text="显示" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="#2563EB"/>
                        <Button x:Name="BtnAxes" Style="{StaticResource ToolBarButton}" Content="坐标轴" Click="ToggleAxes_Click"/>
                        <Button x:Name="BtnBoundingBox" Style="{StaticResource ToolBarButton}" Content="包围盒" Click="ToggleBoundingBox_Click"/>
                        <Button x:Name="BtnColorBar" Style="{StaticResource ToolBarButton}" Content="颜色条" Click="ToggleColorBar_Click"/>
                        <Separator Width="8"/>
                        <Button x:Name="BtnScreenshot" Style="{StaticResource ToolBarButton}" Content="截图" Click="ExportImage_Click"/>
                    </StackPanel>

                    <!-- 第二行：渲染选项 -->
                    <StackPanel Orientation="Horizontal" Margin="10,0,10,7">
                        <TextBlock Text="颜色模式" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="#555"/>
                        <ComboBox x:Name="ColorModeCombo" Width="110" Margin="3" SelectedIndex="0" Style="{StaticResource ModernComboBox}" SelectionChanged="ColorMode_Changed">
                            <ComboBoxItem Content="原始颜色"/>
                            <ComboBoxItem Content="高度映射"/>
                            <ComboBoxItem Content="纯色"/>
                        </ComboBox>

                        <Separator Width="12"/>
                        <TextBlock Text="背景" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="#555"/>
                        <ComboBox x:Name="BgColorCombo" Width="90" Margin="3" SelectedIndex="0" Style="{StaticResource ModernComboBox}" SelectionChanged="BgColor_Changed">
                            <ComboBoxItem Content="浅色"/>
                            <ComboBoxItem Content="深色"/>
                            <ComboBoxItem Content="黑色"/>
                        </ComboBox>

                        <Separator Width="12"/>
                        <TextBlock Text="点大小" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="#555"/>
                        <Slider x:Name="PointSizeSlider" Minimum="1" Maximum="10" Value="2" Width="100"
                                VerticalAlignment="Center" ValueChanged="PointSizeSlider_ValueChanged"/>
                        <TextBlock x:Name="PointSizeLabel" Text="2" VerticalAlignment="Center" Margin="3,0,0,0" Width="16" FontWeight="Bold" Foreground="#2563EB"/>

                        <Separator Width="12"/>
                        <TextBlock Text="示例形状" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="#555"/>
                        <ComboBox x:Name="SampleShapeCombo" Width="90" Margin="3" SelectedIndex="0" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="球体"/>
                            <ComboBoxItem Content="立方体"/>
                            <ComboBoxItem Content="螺旋"/>
                            <ComboBoxItem Content="平面"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 主区域：VTK 视口 + 侧边面板 -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- VTK 单显示框：所有点云叠加在同一 3D 视口，导入后按切片渐显 -->
            <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" Background="#E2E8F0">
                <Grid>
                    <TextBlock x:Name="EmptyPlaceholder"
                               Text="暂无点云&#10;点击“生成示例点云”或导入 PLY/PCD 文件，将按切片渐显显示"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#94A3B8" FontSize="15" TextAlignment="Center" LineHeight="24"/>
                    <wfi:WindowsFormsHost x:Name="VtkHost" Margin="6">
                        <wf:Panel x:Name="VtkPanel" Dock="Fill" BackColor="WhiteSmoke"/>
                    </wfi:WindowsFormsHost>
                </Grid>
            </Border>

            <!-- 侧边面板 -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" Padding="9">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 点云信息（选中点云） -->
                        <TextBlock Text="选中点云信息" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}" Padding="11" Margin="0,0,0,9">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="点数：" Foreground="#666"/>
                                    <TextBlock Grid.Column="1" x:Name="InfoPointCount" Text="—" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="来源：" Foreground="#666"/>
                                    <TextBlock Grid.Column="1" x:Name="InfoSource" Text="—" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <TextBlock x:Name="InfoBoundsX" Text="X: —" Margin="0,2" FontFamily="Consolas"/>
                                <TextBlock x:Name="InfoBoundsY" Text="Y: —" Margin="0,2" FontFamily="Consolas"/>
                                <TextBlock x:Name="InfoBoundsZ" Text="Z: —" Margin="0,2" FontFamily="Consolas"/>
                                <TextBlock x:Name="InfoCenter" Text="中心: —" Margin="0,6,0,0" FontFamily="Consolas" Foreground="#555"/>
                                <TextBlock x:Name="InfoSize" Text="尺寸: —" Margin="0,2" FontFamily="Consolas" Foreground="#555"/>
                                <TextBlock x:Name="InfoVolume" Text="体积: —" Margin="0,6,0,0" FontFamily="Consolas" Foreground="#2563EB" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- 点云列表 -->
                        <TextBlock Text="点云列表（可多选同时显示）" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}" Padding="7" Margin="0,0,0,9">
                            <StackPanel>
                                <ListBox x:Name="CloudListBox" Height="150" SelectionChanged="CloudListBox_SelectionChanged"
                                         ItemContainerStyle="{StaticResource ListBoxItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="1">
                                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Checked="CloudVisible_Checked" Unchecked="CloudVisible_Unchecked"
                                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Rectangle Width="10" Height="10" Fill="{Binding Swatch}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Detail}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                    <Button x:Name="BtnShowAll" Content="全部显示" Width="64" Height="24" FontSize="11" Margin="0,0,4,0"
                                            Style="{StaticResource SmallButton}" Click="ShowAllClouds_Click"/>
                                    <Button x:Name="BtnHideAll" Content="全部隐藏" Width="64" Height="24" FontSize="11"
                                            Style="{StaticResource SmallButton}" Click="HideAllClouds_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="CloudCountText" Text="共 0 个点云" Margin="2,5,0,0" Foreground="#888" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- 切片显示 -->
                        <Expander Header="切片显示（导入后渐显）" Style="{StaticResource ModernExpander}" Margin="0,0,0,9" IsExpanded="True">
                            <Border Style="{StaticResource Card}" Padding="9">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="切片轴:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="SliceAxisCombo" Width="100" SelectedIndex="2" Style="{StaticResource ModernComboBox}" SelectionChanged="SliceAxis_Changed">
                                            <ComboBoxItem Content="X 轴"/>
                                            <ComboBoxItem Content="Y 轴"/>
                                            <ComboBoxItem Content="Z 轴"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                        <TextBlock Text="切片数:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="SliceCountBox" Width="70" Text="50" TextChanged="SliceCount_TextChanged"/>
                                        <TextBlock Text="(2-300)" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#888"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                        <Button x:Name="BtnSlicePlay" Style="{StaticResource SmallButton}" Content="播放/暂停" Width="82" Margin="0,0,4,0" Click="SlicePlay_Click"/>
                                        <Button x:Name="BtnSliceRestart" Style="{StaticResource SmallButton}" Content="重新开始" Width="82" Margin="0,0,4,0" Click="SliceRestart_Click"/>
                                        <Button x:Name="BtnSliceFull" Style="{StaticResource SmallButton}" Content="显示完整" Width="82" Click="SliceFull_Click"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="SliceProgress" Height="14" Minimum="0" Maximum="50" Value="0" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="SliceProgressText" Text="未开始" Margin="0,2,0,0" FontSize="11" Foreground="#888"/>
                                    <TextBlock Text="导入点云后按所选轴逐片渐显，不直接显示完整点云。" Margin="0,4,0,0" FontSize="11" Foreground="#555" TextWrapping="Wrap"/>
                                    <Separator Margin="0,8,0,4"/>
                                    <TextBlock Text="导出切片动画" FontWeight="Bold" Margin="0,2,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="每帧间隔(ms):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="GifDelayBox" Width="58" Text="80"/>
                                        <TextBlock Text="(10-2000)" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#888"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                        <Button x:Name="BtnExportGif" Style="{StaticResource SmallButton}" Content="导出动图(GIF)" Width="112" Margin="0,0,4,0" Click="ExportGif_Click"/>
                                        <Button x:Name="BtnExportVideo" Style="{StaticResource SmallButton}" Content="导出视频(OGV)" Width="112" Click="ExportVideo_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="把当前点云的切片渐显过程录制成动画文件（GIF 通用；OGV 需用 VLC 等播放器）。" Margin="0,4,0,0" FontSize="11" Foreground="#555" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- 体积计算 -->
                        <Expander Header="体积计算" Style="{StaticResource ModernExpander}" Margin="0,0,0,9" IsExpanded="True">
                            <Border Style="{StaticResource Card}" Padding="9">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="体素尺寸:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="VoxelSizeBox" Width="70" Text="0.1"/>
                                        <TextBlock Text="(米)" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#888"/>
                                    </StackPanel>
                                    <Button x:Name="BtnComputeVolume" Style="{StaticResource SmallButton}" Content="计算选中点云体积"
                                            Margin="0,6,0,0" Click="ComputeVolume_Click"/>
                                    <TextBlock x:Name="VolumeResult" Text="—" Margin="0,6,0,0" FontFamily="Consolas" Foreground="#2563EB" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- 裁剪 -->
                        <Expander Header="点云裁剪" Style="{StaticResource ModernExpander}" Margin="0,0,0,9">
                            <Border Style="{StaticResource Card}" Padding="9">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="方式:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="ClipModeCombo" Width="110" SelectedIndex="0" Style="{StaticResource ModernComboBox}" SelectionChanged="ClipMode_Changed">
                                            <ComboBoxItem Content="无裁剪"/>
                                            <ComboBoxItem Content="框选裁剪"/>
                                            <ComboBoxItem Content="平面裁剪"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox x:Name="ClipInsideOutCheck" Content="保留框外/反侧" Margin="0,6,0,4"/>

                                    <!-- 框选参数 -->
                                    <Grid x:Name="BoxClipPanel" Visibility="Collapsed" Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ClipXmin" Margin="1"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="ClipXmax" Margin="1"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Y:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ClipYmin" Margin="1"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="ClipYmax" Margin="1"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Z:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ClipZmin" Margin="1"/>
                                        <TextBox Grid.Row="2" Grid.Column="3" x:Name="ClipZmax" Margin="1"/>
                                    </Grid>

                                    <!-- 平面参数 -->
                                    <Grid x:Name="PlaneClipPanel" Visibility="Collapsed" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="起点:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ClipOX" ToolTip="X" Margin="1"/>
                                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="ClipOY" ToolTip="Y" Margin="1"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="ClipOZ" ToolTip="Z" Margin="1"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="法线:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ClipNX" ToolTip="Nx" Margin="1"/>
                                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="ClipNY" ToolTip="Ny" Margin="1"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="ClipNZ" ToolTip="Nz" Margin="1"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="BtnApplyClip" Style="{StaticResource SmallButton}" Content="应用裁剪" Click="ApplyClip_Click"/>
                                        <Button x:Name="BtnClearClip" Style="{StaticResource SmallButton}" Content="清除裁剪" Click="ClearClip_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- 数据库 -->
                        <Expander Header="数据库（SQLite）" Style="{StaticResource ModernExpander}" Margin="0,0,0,9">
                            <Border Style="{StaticResource Card}" Padding="9">
                                <StackPanel>
                                    <ListBox x:Name="DbListBox" Height="110" SelectionChanged="DbListBox_SelectionChanged"
                                             ItemContainerStyle="{StaticResource ListBoxItemStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="11"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button x:Name="BtnDbReload" Style="{StaticResource SmallButton}" Content="重载选中" Click="DbReload_Click"/>
                                        <Button x:Name="BtnDbDelete" Style="{StaticResource SmallButton}" Content="删除选中" Click="DbDelete_Click"/>
                                        <Button x:Name="BtnDbRefresh" Style="{StaticResource SmallButton}" Content="刷新" Click="DbRefresh_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DbStatus" Text="—" Margin="0,5,0,0" FontSize="11" Foreground="#888"/>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- MQTT -->
                        <Expander Header="MQTT（发布状态）" Style="{StaticResource ModernExpander}" Margin="0,0,0,9">
                            <Border Style="{StaticResource Card}" Padding="9">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Broker:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MqttHost" Text="broker.emqx.io" Margin="1"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="端口:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MqttPort" Text="1883" Margin="1"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="主题:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MqttTopic" Text="wpfapp1/pointcloud/status" Margin="1"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ClientId:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="MqttClientId" Margin="1"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button x:Name="BtnMqttConnect" Style="{StaticResource SmallButton}" Content="连接" Click="MqttConnect_Click"/>
                                        <Button x:Name="BtnMqttDisconnect" Style="{StaticResource SmallButton}" Content="断开" Click="MqttDisconnect_Click"/>
                                        <Button x:Name="BtnMqttPublish" Style="{StaticResource SmallButton}" Content="发布当前状态" Click="MqttPublish_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MqttStatus" Text="未连接" Margin="0,5,0,0" FontSize="11" Foreground="#888"/>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- 操作说明 -->
                        <Expander Header="操作说明" Style="{StaticResource ModernExpander}">
                            <Border Style="{StaticResource Card}" Padding="9">
                                <StackPanel>
                                    <TextBlock Text="左键拖拽：旋转" Margin="0,2" FontSize="12" Foreground="#555"/>
                                    <TextBlock Text="右键拖拽：平移" Margin="0,2" FontSize="12" Foreground="#555"/>
                                    <TextBlock Text="滚轮：缩放" Margin="0,2" FontSize="12" Foreground="#555"/>
                                    <TextBlock Text="在『点云列表』中选择一项以操作其颜色/裁剪/体积" Margin="0,2" FontSize="12" Foreground="#555" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="#374151"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusFps" Text="" Foreground="#6B7280"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusVtk" Text="VTK 初始化中..." Foreground="#2563EB"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
