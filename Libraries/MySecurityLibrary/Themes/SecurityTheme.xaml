<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ============================================================================
      MySecurityLibrary 轻量视觉主题
      ============================================================================
      本库要能被别的程序集直接引用，不能反过来依赖 PLCTesting 的 AppTheme.xaml，
      所以这里自带一份等值的语义色（与 PLCTesting/Themes/AppTheme.xaml 保持同一套 hex）。
      改配色时两处要一起改，否则登录窗会和主界面"两种蓝"。
      ============================================================================
    -->

    <SolidColorBrush x:Key="SecPageBg" Color="#F5F7FA" />
    <SolidColorBrush x:Key="SecSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecSurfaceAlt" Color="#F7F9FC" />
    <SolidColorBrush x:Key="SecBorder" Color="#EBEEF5" />
    <SolidColorBrush x:Key="SecBorderStrong" Color="#DCDFE6" />

    <SolidColorBrush x:Key="SecText" Color="#303133" />
    <SolidColorBrush x:Key="SecTextSub" Color="#606266" />
    <SolidColorBrush x:Key="SecTextFaint" Color="#909399" />

    <SolidColorBrush x:Key="SecAccent" Color="#409EFF" />
    <SolidColorBrush x:Key="SecAccentSoft" Color="#ECF5FF" />
    <SolidColorBrush x:Key="SecSuccess" Color="#67C23A" />
    <SolidColorBrush x:Key="SecDanger" Color="#F56C6C" />

    <!-- 标题 / 标签 / 说明 -->
    <Style x:Key="SecTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SecText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SecLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SecTextSub}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="SecCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SecTextFaint}" />
    </Style>

    <!-- 按钮 -->
    <Style x:Key="SecBtnBase" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SecSurface}" />
        <Setter Property="Foreground" Value="{StaticResource SecTextSub}" />
        <Setter Property="BorderBrush" Value="{StaticResource SecBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecBtnPrimary" TargetType="Button" BasedOn="{StaticResource SecBtnBase}">
        <Setter Property="Background" Value="{StaticResource SecAccent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource SecAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecBtnSecondary" TargetType="Button" BasedOn="{StaticResource SecBtnBase}" />

    <Style x:Key="SecBtnDanger" TargetType="Button" BasedOn="{StaticResource SecBtnBase}">
        <Setter Property="Background" Value="{StaticResource SecDanger}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource SecDanger}" />
    </Style>

    <!-- 输入框（TextBox / PasswordBox 共用一套边框） -->
    <Style x:Key="SecInput" TargetType="TextBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Foreground" Value="{StaticResource SecText}" />
        <Setter Property="Background" Value="{StaticResource SecSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource SecBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#C0C4CC" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SecAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecPassword" TargetType="PasswordBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Foreground" Value="{StaticResource SecText}" />
        <Setter Property="Background" Value="{StaticResource SecSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource SecBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#C0C4CC" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SecAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
