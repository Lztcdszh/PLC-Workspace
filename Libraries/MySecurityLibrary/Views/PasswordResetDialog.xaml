<Window x:Class="MySecurityLibrary.Views.PasswordResetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重置密码"
        Width="380" Height="280"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MySecurityLibrary;component/Themes/SecurityTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource SecSurface}"
            BorderBrush="{StaticResource SecBorder}" BorderThickness="1" Margin="12">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="🔑 重置密码" Style="{StaticResource SecTitle}" Margin="0,0,0,16" />

            <StackPanel Grid.Row="1">
                <TextBlock Text="新密码" Style="{StaticResource SecLabel}" />
                <PasswordBox x:Name="PwdBox" Height="34" Style="{StaticResource SecPassword}" />

                <TextBlock Text="确认新密码" Style="{StaticResource SecLabel}" Margin="0,12,0,6" />
                <PasswordBox x:Name="PwdConfirmBox" Height="34" Style="{StaticResource SecPassword}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Width="92" Height="34" Margin="0,0,10,0"
                        Style="{StaticResource SecBtnSecondary}" Click="BtnCancel_Click" />
                <Button Content="确定" Width="92" Height="34"
                        Style="{StaticResource SecBtnPrimary}" Click="BtnOk_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
