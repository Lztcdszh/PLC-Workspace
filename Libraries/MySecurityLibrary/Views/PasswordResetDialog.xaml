<Window x:Class="MySecurityLibrary.Views.PasswordResetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重置密码"
        Width="360" Height="240"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif">

    <Border CornerRadius="12" BorderThickness="1" BorderBrush="#1E4A6E" Margin="12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0E2036" Offset="0" />
                <GradientStop Color="#123048" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="🔑 重置密码" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" />

            <StackPanel Grid.Row="1">
                <TextBlock Text="新密码" FontSize="12" Foreground="#B7D4EC" Margin="0,0,0,4" />
                <PasswordBox x:Name="PwdBox" Height="32" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"
                             Background="#0C1B2E" Foreground="White" BorderBrush="#2B5C82" BorderThickness="1" />
                <TextBlock Text="确认新密码" FontSize="12" Foreground="#B7D4EC" Margin="0,12,0,4" />
                <PasswordBox x:Name="PwdConfirmBox" Height="32" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"
                             Background="#0C1B2E" Foreground="White" BorderBrush="#2B5C82" BorderThickness="1" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Width="90" Height="34" Margin="0,0,10,0" Click="BtnCancel_Click"
                        Background="#3A4D63" Foreground="White" BorderThickness="0" Cursor="Hand" />
                <Button Content="确定" Width="90" Height="34" Click="BtnOk_Click"
                        Background="#00E5FF" Foreground="#06283D" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
