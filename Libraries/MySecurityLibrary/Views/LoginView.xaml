<Window x:Class="MySecurityLibrary.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户登录"
        Width="380" Height="470"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif">

    <Border CornerRadius="14" BorderThickness="1" BorderBrush="#1E4A6E" Margin="12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0E2036" Offset="0" />
                <GradientStop Color="#123048" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题区 -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔐" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.8" Color="#00E5FF" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="用户登录" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 关闭按钮：不登录直接退出程序 -->
                <Button x:Name="BtnClose" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="28" Height="28" Content="✕" FontSize="13" FontWeight="Bold"
                        Foreground="#9FD6FF" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="关闭并退出程序" Click="BtnClose_Click" />
            </Grid>

            <!-- 表单 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="用户名" FontSize="12" Foreground="#B7D4EC" Margin="0,0,0,6" />
                <TextBox x:Name="UserNameBox" Height="38" FontSize="14" Padding="10,0" VerticalContentAlignment="Center"
                         Background="#0C1B2E" Foreground="White" BorderBrush="#2B5C82" BorderThickness="1"
                         KeyDown="Input_KeyDown" />
                <TextBlock Text="密码" FontSize="12" Foreground="#B7D4EC" Margin="0,16,0,6" />
                <PasswordBox x:Name="PasswordBox" Height="38" FontSize="14" Padding="10,0" VerticalContentAlignment="Center"
                             Background="#0C1B2E" Foreground="White" BorderBrush="#2B5C82" BorderThickness="1"
                             KeyDown="Input_KeyDown" />
                <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="12"
                           Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="16" />
            </StackPanel>

            <!-- 登录按钮 + 提示 -->
            <StackPanel Grid.Row="2">
                <Button Content="登 录" Height="42" FontSize="14" FontWeight="Bold" Foreground="#06283D"
                        Background="#00E5FF" BorderThickness="0" Cursor="Hand" Click="BtnLogin_Click">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="#00E5FF" />
                    </Button.Effect>
                </Button>
                <TextBlock FontSize="10.5" Foreground="#6E8BA6" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="17">
                    默认管理员账号：<Run Foreground="#9FD6FF" FontWeight="Bold">admin</Run> / 密码
                    <Run Foreground="#9FD6FF" FontWeight="Bold">admin123</Run>（登录后请及时在「用户管理」中修改）。
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
