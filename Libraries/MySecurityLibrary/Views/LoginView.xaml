<Window x:Class="MySecurityLibrary.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户登录"
        Width="400" Height="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MySecurityLibrary;component/Themes/SecurityTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 浅色圆角卡片：与主程序白卡风格一致 -->
    <Border CornerRadius="14" Background="{StaticResource SecSurface}"
            BorderBrush="{StaticResource SecBorder}" BorderThickness="1" Margin="12">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题区 -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource SecAccentSoft}" Margin="0,0,10,0">
                        <TextBlock Text="🔐" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="用户登录" Style="{StaticResource SecTitle}" />
                        <TextBlock Text="PLC 监控台" Style="{StaticResource SecCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 关闭按钮：不登录直接退出程序 -->
                <Button x:Name="BtnClose" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="28" Height="28" Content="✕" FontSize="13"
                        Foreground="{StaticResource SecTextFaint}" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="关闭并退出程序" Click="BtnClose_Click" />
            </Grid>

            <!-- 表单 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="用户名" Style="{StaticResource SecLabel}" />
                <TextBox x:Name="UserNameBox" Height="40" Style="{StaticResource SecInput}"
                         KeyDown="Input_KeyDown" />

                <TextBlock Text="密码" Style="{StaticResource SecLabel}" Margin="0,16,0,6" />
                <PasswordBox x:Name="PasswordBox" Height="40" Style="{StaticResource SecPassword}"
                             KeyDown="Input_KeyDown" />

                <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" Foreground="{StaticResource SecDanger}"
                           FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="16" />
            </StackPanel>

            <!-- 登录按钮 + 提示 -->
            <StackPanel Grid.Row="2">
                <Button Content="登 录" Height="42" Style="{StaticResource SecBtnPrimary}"
                        FontSize="14" Click="BtnLogin_Click" />
                <TextBlock FontSize="11" Foreground="{StaticResource SecTextFaint}" Margin="0,14,0,0"
                           TextWrapping="Wrap" LineHeight="18">
                    默认管理员账号：<Run Foreground="{StaticResource SecAccent}" FontWeight="SemiBold">admin</Run> / 密码
                    <Run Foreground="{StaticResource SecAccent}" FontWeight="SemiBold">admin123</Run>（登录后请及时在「用户管理」中修改）。
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
