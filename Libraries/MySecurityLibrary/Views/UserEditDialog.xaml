<Window x:Class="MySecurityLibrary.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MySecurityLibrary.Views"
        Title="用户编辑"
        Width="400" Height="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif">

    <Window.Resources>
        <local:RoleDisplayNameConverter x:Key="RoleNameConverter" />
        <DataTemplate x:Key="RoleItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource RoleNameConverter}}" />
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="12" BorderThickness="1" BorderBrush="#1E4A6E" Margin="12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0E2036" Offset="0" />
                <GradientStop Color="#123048" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText" Text="新增用户" FontSize="15" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,12" />

            <StackPanel Grid.Row="1">
                <TextBlock Text="用户名" FontSize="12" Foreground="#B7D4EC" Margin="0,0,0,4" />
                <TextBox x:Name="UserNameBox" Height="32" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"
                         Background="#0C1B2E" Foreground="White" BorderBrush="#2B5C82" BorderThickness="1" />

                <TextBlock Text="显示名" FontSize="12" Foreground="#B7D4EC" Margin="0,10,0,4" />
                <TextBox x:Name="DisplayNameBox" Height="32" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"
                         Background="#0C1B2E" Foreground="White" BorderBrush="#2B5C82" BorderThickness="1" />

                <TextBlock Text="角色" FontSize="12" Foreground="#B7D4EC" Margin="0,10,0,4" />
                <ComboBox x:Name="RoleCombo" Height="32" FontSize="13"
                          ItemTemplate="{StaticResource RoleItemTemplate}"
                          Background="#0C1B2E" Foreground="White" BorderBrush="#2B5C82" />

                <CheckBox x:Name="EnabledBox" Content="启用该账号" FontSize="12" Foreground="#B7D4EC"
                          Margin="0,12,0,0" IsChecked="True" />

                <TextBlock x:Name="PwdLabel" Text="密码" FontSize="12" Foreground="#B7D4EC" Margin="0,12,0,4" />
                <PasswordBox x:Name="PasswordBox" Height="32" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"
                             Background="#0C1B2E" Foreground="White" BorderBrush="#2B5C82" BorderThickness="1" />
                <TextBlock x:Name="PwdHint" FontSize="10.5" Foreground="#6E8BA6" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Width="90" Height="34" Margin="0,0,10,0" Click="BtnCancel_Click"
                        Background="#3A4D63" Foreground="White" BorderThickness="0" Cursor="Hand" />
                <Button Content="保存" Width="90" Height="34" Click="BtnSave_Click"
                        Background="#00E5FF" Foreground="#06283D" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
