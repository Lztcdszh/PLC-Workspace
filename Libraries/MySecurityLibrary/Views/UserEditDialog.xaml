<Window x:Class="MySecurityLibrary.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MySecurityLibrary.Views"
        Title="用户编辑"
        Width="420" Height="470"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MySecurityLibrary;component/Themes/SecurityTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:RoleDisplayNameConverter x:Key="RoleNameConverter" />
            <DataTemplate x:Key="RoleItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource RoleNameConverter}}" />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource SecSurface}"
            BorderBrush="{StaticResource SecBorder}" BorderThickness="1" Margin="12">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText" Text="新增用户" Style="{StaticResource SecTitle}"
                       Margin="0,0,0,16" />

            <StackPanel Grid.Row="1">
                <TextBlock Text="用户名" Style="{StaticResource SecLabel}" />
                <TextBox x:Name="UserNameBox" Height="34" Style="{StaticResource SecInput}" />

                <TextBlock Text="显示名" Style="{StaticResource SecLabel}" Margin="0,12,0,6" />
                <TextBox x:Name="DisplayNameBox" Height="34" Style="{StaticResource SecInput}" />

                <TextBlock Text="角色" Style="{StaticResource SecLabel}" Margin="0,12,0,6" />
                <ComboBox x:Name="RoleCombo" Height="34" FontSize="13" Padding="6,3"
                          VerticalContentAlignment="Center"
                          ItemTemplate="{StaticResource RoleItemTemplate}" />

                <CheckBox x:Name="EnabledBox" Content="启用该账号" FontSize="12"
                          Foreground="{StaticResource SecTextSub}" Margin="0,14,0,0" IsChecked="True" />

                <TextBlock x:Name="PwdLabel" Text="密码" Style="{StaticResource SecLabel}" Margin="0,14,0,6" />
                <PasswordBox x:Name="PasswordBox" Height="34" Style="{StaticResource SecPassword}" />
                <TextBlock x:Name="PwdHint" Style="{StaticResource SecCaption}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Width="92" Height="34" Margin="0,0,10,0"
                        Style="{StaticResource SecBtnSecondary}" Click="BtnCancel_Click" />
                <Button Content="保存" Width="92" Height="34"
                        Style="{StaticResource SecBtnPrimary}" Click="BtnSave_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
