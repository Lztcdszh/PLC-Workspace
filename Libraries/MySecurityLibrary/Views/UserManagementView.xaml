<Window x:Class="MySecurityLibrary.Views.UserManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MySecurityLibrary.Views"
        Title="用户管理"
        Width="760" Height="540"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        Background="#0A1424">

    <Window.Resources>
        <local:RoleDisplayNameConverter x:Key="RoleNameConverter" />
        <local:BoolToTextConverter x:Key="EnabledText" TrueText="启用" FalseText="禁用" />
        <local:BoolToBrushConverter x:Key="EnabledBrush" TrueBrush="#67C23A" FalseBrush="#F56C6C" />

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#123A5A" />
            <Setter Property="Foreground" Value="#D6E9FF" />
            <Setter Property="BorderBrush" Value="#2B5C82" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#123048" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="👤" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.7" Color="#00E5FF" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="用户管理" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="（仅管理员可访问）" FontSize="11" Foreground="#7FA8C9" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="➕ 新增" Style="{StaticResource ToolBtn}" Command="{Binding AddCommand}" Margin="0,0,6,0" />
            <Button Content="✏️ 编辑" Style="{StaticResource ToolBtn}" Command="{Binding EditCommand}" Margin="0,0,6,0" />
            <Button Content="🔑 重置密码" Style="{StaticResource ToolBtn}" Command="{Binding ResetPasswordCommand}" Margin="0,0,6,0" />
            <Button Content="🗑 删除" Style="{StaticResource ToolBtn}" Command="{Binding DeleteCommand}" Margin="0,0,6,0" />
            <Button Content="🔄 刷新" Style="{StaticResource ToolBtn}" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <!-- 用户列表 -->
        <Border Grid.Row="2" Background="#0C1B2E" CornerRadius="8" BorderBrush="#1E4A6E" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" RowHeaderWidth="0"
                      Background="Transparent" Foreground="#D6E9FF" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#16324B" VerticalGridLinesBrush="Transparent"
                      BorderThickness="0" RowHeight="34" FontSize="12"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0E2438" />
                        <Setter Property="Foreground" Value="#7FA8C9" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="BorderBrush" Value="#16324B" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#16395A" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="120" />
                    <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" Width="140" />
                    <DataGridTextColumn Header="角色" Binding="{Binding Role, Converter={StaticResource RoleNameConverter}}" Width="100" />
                    <DataGridTemplateColumn Header="状态" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                             Fill="{Binding IsEnabled, Converter={StaticResource EnabledBrush}}" />
                                    <TextBlock Text="{Binding IsEnabled, Converter={StaticResource EnabledText}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="最近登录" Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="LastLoginAt" StringFormat="{}{0:yyyy-MM-dd HH:mm}" TargetNullValue="—" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
