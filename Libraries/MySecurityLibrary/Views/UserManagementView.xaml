<Window x:Class="MySecurityLibrary.Views.UserManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MySecurityLibrary.Views"
        Title="用户管理"
        Width="820" Height="580"
        MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        Background="#141414"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MySecurityLibrary;component/Themes/SecurityTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:RoleDisplayNameConverter x:Key="RoleNameConverter" />
            <local:BoolToTextConverter x:Key="EnabledText" TrueText="启用" FalseText="禁用" />
            <local:BoolToBrushConverter x:Key="EnabledBrush" TrueBrush="#67C23A" FalseBrush="#F56C6C" />

            <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource SecBtnSecondary}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="{StaticResource SecSurface}" />
                <Setter Property="Foreground" Value="{StaticResource SecText}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="RowBackground" Value="{StaticResource SecSurface}" />
                <Setter Property="AlternatingRowBackground" Value="#232323" />
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SecBorder}" />
                <Setter Property="VerticalGridLinesBrush" Value="{StaticResource SecBorder}" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeight" Value="34" />
                <Setter Property="BorderBrush" Value="{StaticResource SecBorder}" />
            </Style>

            <!-- 行级状态：默认模板的选中行会刷系统高亮蓝，压成深色语义 -->
            <Style TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{StaticResource SecText}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource SecSurfaceAlt}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource SecAccentSoft}" />
                        <Setter Property="Foreground" Value="{StaticResource SecText}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource SecSurfaceAlt}" />
                <Setter Property="Foreground" Value="{StaticResource SecTextSub}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderBrush" Value="{StaticResource SecBorder}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Foreground" Value="{StaticResource SecText}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource SecAccentSoft}" />
                        <Setter Property="Foreground" Value="{StaticResource SecText}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource SecAccentSoft}" Margin="0,0,10,0">
                <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="用户管理" Style="{StaticResource SecTitle}" />
                <TextBlock Text="仅管理员可访问" Style="{StaticResource SecCaption}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="➕ 新增" Style="{StaticResource ToolBtn}" Command="{Binding AddCommand}" />
            <Button Content="✏️ 编辑" Style="{StaticResource ToolBtn}" Command="{Binding EditCommand}" />
            <Button Content="🔑 重置密码" Style="{StaticResource ToolBtn}" Command="{Binding ResetPasswordCommand}" />
            <Button Content="🗑 删除" Style="{StaticResource ToolBtn}" Command="{Binding DeleteCommand}" />
            <Button Content="🔄 刷新" Style="{StaticResource ToolBtn}" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <!-- 用户列表 -->
        <Border Grid.Row="2" Background="{StaticResource SecSurface}" CornerRadius="10"
                BorderBrush="{StaticResource SecBorderStrong}" BorderThickness="1" Padding="1">
            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" RowHeaderWidth="0"
                      Background="Transparent" BorderThickness="0"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="120" />
                    <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" Width="140" />
                    <DataGridTextColumn Header="角色" Binding="{Binding Role, Converter={StaticResource RoleNameConverter}}" Width="100" />
                    <DataGridTemplateColumn Header="状态" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                             Fill="{Binding IsEnabled, Converter={StaticResource EnabledBrush}}" />
                                    <TextBlock Text="{Binding IsEnabled, Converter={StaticResource EnabledText}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="最近登录" Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="LastLoginAt" StringFormat="{}{0:yyyy-MM-dd HH:mm}" TargetNullValue="—" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
