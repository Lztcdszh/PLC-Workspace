<local:PlcControlBase x:Class="MyPLCUserControlLibrary.PlcIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyPLCUserControlLibrary"
             Background="Transparent" BorderThickness="0"
             ToolTip="{Binding ToolTipText, RelativeSource={RelativeSource Self}}">
    <local:PlcControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MyPLCUserControlLibrary;component/Themes/PlcStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:PlcControlBase.Resources>

    <Grid>
        <Ellipse x:Name="PART_Ellipse"
                 Width="{Binding Width, RelativeSource={RelativeSource AncestorType=local:PlcControlBase}}"
                 Height="{Binding Height, RelativeSource={RelativeSource AncestorType=local:PlcControlBase}}"
                 Stroke="{StaticResource PlcBorderBrush}"
                 StrokeThickness="1.5"
                 Fill="Gray">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</local:PlcControlBase>
