<local:PlcControlBase x:Class="MyPLCUserControlLibrary.PlcBarIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyPLCUserControlLibrary"
             Background="Transparent" BorderThickness="0"
             ToolTip="{Binding ToolTipText, RelativeSource={RelativeSource Self}}">

    <local:PlcControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MyPLCUserControlLibrary;component/Themes/PlcStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </local:PlcControlBase.Resources>

    <Border x:Name="PART_BackgroundBorder"
            Background="{Binding BackgroundBrush, RelativeSource={RelativeSource AncestorType=local:PlcBarIndicator}}"
            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=local:PlcBarIndicator}}"
            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=local:PlcBarIndicator}}"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=local:PlcBarIndicator}}">
        <Grid>
            <!-- 填充矩形 -->
            <Border x:Name="PART_FillBorder"
                    Background="{Binding CurrentFillBrush, RelativeSource={RelativeSource AncestorType=local:PlcBarIndicator}}"
                    CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=local:PlcBarIndicator}}"/>

            <!-- 数值文本 -->
            <TextBlock x:Name="PART_ValueText"
                       Text="{Binding DisplayText, RelativeSource={RelativeSource AncestorType=local:PlcBarIndicator}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource PlcFontFamily}"
                       FontSize="{Binding TextFontSize, RelativeSource={RelativeSource AncestorType=local:PlcBarIndicator}}"
                       FontWeight="SemiBold"
                       Foreground="{Binding TextForeground, RelativeSource={RelativeSource AncestorType=local:PlcBarIndicator}}"
                       Visibility="{Binding ShowValue, RelativeSource={RelativeSource AncestorType=local:PlcBarIndicator}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Border>
</local:PlcControlBase>
