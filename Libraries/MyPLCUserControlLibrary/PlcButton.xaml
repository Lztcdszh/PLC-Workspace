<local:PlcControlBase x:Class="MyPLCUserControlLibrary.PlcButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MyPLCUserControlLibrary"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="100"
             d:DataContext="{d:DesignInstance Type=local:PlcButton, IsDesignTimeCreatable=False}"
             Background="LightGray"
             BorderBrush="Gray"
             BorderThickness="1"
             Cursor="Hand"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <local:PlcControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MyPLCUserControlLibrary;component/Themes/PlcStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:PlcControlBase.Resources>

    <UserControl.Template>
        <ControlTemplate TargetType="local:PlcButton">
            <!-- 清晰阴影：用半透明背板模拟，不使用 DropShadowEffect（避免高分屏离屏位图拉伸发糊）。 -->
            <Grid>
                <Border x:Name="PART_Shadow"
                        Background="#20242B"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Margin="0,1,0,0"
                        Opacity="0.12"
                        SnapsToDevicePixels="True"/>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <!-- 内容呈现器：居中显示 -->
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                        <!-- 遮罩层：用于按下效果，初始透明 -->
                        <Border x:Name="Overlay"
                                Background="#30000000"
                                Opacity="0"
                                IsHitTestVisible="False"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                    </Grid>
                </Border>
            </Grid>

            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource PlcAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="PART_Border" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Template>
</local:PlcControlBase>
