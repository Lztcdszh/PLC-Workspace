<local:PlcControlBase x:Class="MyPLCUserControlLibrary.PlcStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MyPLCUserControlLibrary"
             mc:Ignorable="d"
             d:DesignHeight="16" d:DesignWidth="60"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Center"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <local:PlcControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MyPLCUserControlLibrary;component/Themes/PlcStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:PlcControlBase.Resources>

    <UserControl.Template>
        <ControlTemplate TargetType="local:PlcStatusBar">
            <!-- 根 Border 默认随容器拉伸；横向时固定高度、竖向时固定宽度（取 BarHeight 作厚度） -->
            <Border x:Name="PART_Bar"
                    Background="{TemplateBinding InactiveBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    SnapsToDevicePixels="True"/>

            <ControlTemplate.Triggers>
                <!-- 横向（默认）：高度固定为 BarHeight，宽度随容器拉伸 -->
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter TargetName="PART_Bar" Property="Height" Value="{Binding BarHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
                </Trigger>

                <!-- 竖向：宽度固定为 BarHeight（厚度），高度随容器拉伸 -->
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter TargetName="PART_Bar" Property="Width" Value="{Binding BarHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
                </Trigger>

                <!-- 当前 PLC 值与 ActiveValue 相等 -> 该号位到位，使用激活色（橙色）高亮 -->
                <Trigger Property="IsActive" Value="True">
                    <Setter TargetName="PART_Bar"
                            Property="Background"
                            Value="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                </Trigger>

                <!-- 激活且允许闪烁 -> 透明度往复动画，便于在深色背景上引起注意 -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsActive" Value="True"/>
                        <Condition Property="Blink" Value="True"/>
                    </MultiTrigger.Conditions>
                    <MultiTrigger.EnterActions>
                        <BeginStoryboard x:Name="BlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="PART_Bar"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.3" Duration="0:0:0.6" AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiTrigger.EnterActions>
                    <MultiTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                    </MultiTrigger.ExitActions>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Template>
</local:PlcControlBase>
