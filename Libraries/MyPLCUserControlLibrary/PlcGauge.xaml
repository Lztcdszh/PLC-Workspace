<local:PlcControlBase x:Class="MyPLCUserControlLibrary.PlcGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyPLCUserControlLibrary"
             Background="Transparent" BorderThickness="0">
    <local:PlcControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MyPLCUserControlLibrary;component/Themes/PlcStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:PlcControlBase.Resources>

    <Border Style="{StaticResource PlcCardBorder}" Effect="{StaticResource PlcSoftShadow}" Padding="6">
        <Canvas x:Name="PART_Canvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="False">
            <!-- 背景轨道 -->
            <Path x:Name="PART_Track" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
            <!-- 主刻度 -->
            <Canvas x:Name="PART_Ticks"/>
            <!-- 数值弧 -->
            <Path x:Name="PART_Value" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
            <!-- 指针 -->
            <Line x:Name="PART_Needle" Stroke="#303133" StrokeThickness="2.5"/>
            <!-- 中心轴帽 -->
            <Ellipse x:Name="PART_Hub" Width="10" Height="10" Fill="#303133" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- 读数 -->
            <StackPanel x:Name="PART_Readout" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="PART_ValueText" Text="--" FontSize="22" FontWeight="Bold"
                           FontFamily="{StaticResource PlcFontFamily}"
                           Foreground="{StaticResource PlcTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="PART_UnitText" Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=local:PlcGauge}}"
                           FontSize="11" Foreground="{StaticResource PlcTextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock x:Name="PART_Label" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=local:PlcGauge}}"
                           FontSize="12" Foreground="{StaticResource PlcTextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Canvas>
    </Border>
</local:PlcControlBase>
