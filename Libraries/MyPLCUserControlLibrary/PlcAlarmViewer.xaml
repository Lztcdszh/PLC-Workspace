<local:PlcControlBase x:Class="MyPLCUserControlLibrary.PlcAlarmViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyPLCUserControlLibrary"
             Background="Transparent" BorderThickness="0">
    <local:PlcControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MyPLCUserControlLibrary;component/Themes/PlcStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <Style x:Key="AckBtnStyle" TargetType="Button">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="{StaticResource PlcFontFamily}"/>
                <Setter Property="Foreground" Value="{StaticResource PlcTextBrush}"/>
                <Setter Property="Background" Value="{StaticResource PlcSurfaceAltBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PlcBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Acked}" Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Setter Property="Content" Value="已确认"/>
                        <Setter Property="Foreground" Value="{StaticResource PlcTextSecondaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </local:PlcControlBase.Resources>

    <Border Style="{StaticResource PlcCardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（左侧强调条） -->
            <Border Grid.Row="0" Background="{StaticResource PlcSurfaceAltBrush}"
                    BorderBrush="{StaticResource PlcBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="10,7">
                    <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                               Fill="{StaticResource PlcDangerBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=local:PlcAlarmViewer}}"
                               Style="{StaticResource PlcHeaderText}"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="PART_Alarms" Grid.Row="1"
                          ItemsSource="{Binding ActiveAlarms, RelativeSource={RelativeSource AncestorType=local:PlcAlarmViewer}}"
                          Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6"
                                BorderBrush="{StaticResource PlcBorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="8,6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#262626"/>
                                    <GradientStop Offset="1" Color="#232323"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2"
                                           Fill="{Binding SeverityBrush}" VerticalAlignment="Stretch" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11"
                                           Foreground="{StaticResource PlcTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="13"
                                           FontFamily="{StaticResource PlcFontFamily}"
                                           Foreground="{StaticResource PlcTextBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="确认" Click="AckButton_Click"
                                        Style="{StaticResource AckBtnStyle}"
                                        Visibility="{Binding ShowAck, RelativeSource={RelativeSource AncestorType=local:PlcAlarmViewer}, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="PART_EmptyHint" Grid.Row="1" Text="无活动报警"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Style="{StaticResource PlcSecondaryText}" Visibility="Collapsed"/>
        </Grid>
    </Border>
</local:PlcControlBase>
