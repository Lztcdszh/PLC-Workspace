<Window x:Class="MyPLCUserControlLibrary.PlcTrendSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyPLCUserControlLibrary"
        Title="趋势曲线属性"
        Width="330"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MyPLCUserControlLibrary;component/Themes/PlcStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBooleanConverter x:Key="InverseBool"/>
            <!-- GroupBox：Aero 模板的边框是写死的浅色，深色下会画出一圈白框，故自绘 -->
            <Style TargetType="GroupBox">
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource PlcTextBrush}"/>
                <Setter Property="Background" Value="{StaticResource PlcSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PlcBorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="0" ContentSource="Header"
                                                  Margin="2,0,0,4"
                                                  TextElement.Foreground="{StaticResource PlcTextBrush}"
                                                  TextElement.FontWeight="SemiBold"/>
                                <Border Grid.Row="1"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Foreground" Value="{StaticResource PlcTextBrush}"/>
            </Style>
            <!-- 深色复选框：默认模板的方块取系统浅色，在深色窗上是一块小白砖，故自绘 -->
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource PlcTextBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid x:Name="Root" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Grid.Column="0" Width="15" Height="15" CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource PlcSurfaceAltBrush}"
                                        BorderBrush="{StaticResource PlcBorderBrush}"
                                        BorderThickness="1" SnapsToDevicePixels="True">
                                    <Path x:Name="Check" Width="9" Height="7" Stretch="Fill" Visibility="Collapsed"
                                          Data="M0,3 L3.2,6.2 L9,0.4"
                                          Stroke="{StaticResource PlcAccentBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{StaticResource PlcTextBrush}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PlcAccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PlcAccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 深色输入框：模板取系统浅色会在深色窗上变成白块 -->
            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="Foreground" Value="{StaticResource PlcTextBrush}"/>
                <Setter Property="Background" Value="{StaticResource PlcSurfaceAltBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PlcBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{StaticResource PlcTextBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Background>
        <StaticResource ResourceKey="PlcSurfaceBrush"/>
    </Window.Background>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- 标题 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="标题"/>
                <TextBox x:Name="TxtTitle" Grid.Column="1" Height="24" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Y 轴量程 -->
            <GroupBox Header="Y 轴量程">
                <StackPanel>
                    <CheckBox x:Name="ChkAutoScale" Content="自动缩放 Y 轴"/>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最小值"/>
                        <TextBox x:Name="TxtMinY" Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                 IsEnabled="{Binding IsChecked, ElementName=ChkAutoScale, Converter={StaticResource InverseBool}}"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最大值"/>
                        <TextBox x:Name="TxtMaxY" Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                 IsEnabled="{Binding IsChecked, ElementName=ChkAutoScale, Converter={StaticResource InverseBool}}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- 报警 -->
            <GroupBox Header="报警（超过报警值曲线变红）">
                <StackPanel>
                    <CheckBox x:Name="ChkAlarm" Content="启用报警"/>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="报警值"/>
                        <TextBox x:Name="TxtAlarm" Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                 IsEnabled="{Binding IsChecked, ElementName=ChkAlarm}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="BtnOk" Content="确定" Width="75" Height="30" Margin="0,0,8,0"
                    Background="{StaticResource PlcAccentBrush}" Foreground="White" BorderThickness="0"
                    FontSize="13" Click="BtnOk_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="取消" Width="75" Height="30"
                    Background="{StaticResource PlcSurfaceAltBrush}" Foreground="{StaticResource PlcTextBrush}" BorderThickness="0"
                    FontSize="13" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
