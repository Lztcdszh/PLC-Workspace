<local:PlcControlBase x:Class="MyPLCUserControlLibrary.PlcSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyPLCUserControlLibrary"
             Background="Transparent" BorderThickness="0"
             Cursor="Hand">
    <local:PlcControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MyPLCUserControlLibrary;component/Themes/PlcStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:PlcControlBase.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4">
        <Canvas x:Name="PART_Canvas" Width="52" Height="28" VerticalAlignment="Center">
            <Border x:Name="PART_Track" Width="52" Height="28" CornerRadius="14"
                    Background="{StaticResource PlcInfoBrush}"/>
            <Ellipse x:Name="PART_Thumb" Width="22" Height="22" Fill="White" Canvas.Left="3" Canvas.Top="3"/>
        </Canvas>
        <TextBlock x:Name="PART_StateText" Text="OFF" Margin="8,0,0,0"
                   FontFamily="{StaticResource PlcFontFamily}"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource PlcTextBrush}" VerticalAlignment="Center"/>
    </StackPanel>
</local:PlcControlBase>
