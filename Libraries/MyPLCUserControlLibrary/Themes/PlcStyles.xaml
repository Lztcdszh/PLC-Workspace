<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 语义主色（与 PlcPalette.cs 保持一致） ============ -->
    <Color x:Key="PlcAccentColor">#409EFF</Color>
    <Color x:Key="PlcSuccessColor">#67C23A</Color>
    <Color x:Key="PlcWarningColor">#E6A23C</Color>
    <Color x:Key="PlcDangerColor">#F56C6C</Color>
    <Color x:Key="PlcInfoColor">#909399</Color>
    <Color x:Key="PlcOffColor">#525A66</Color>

    <!-- ============ 文本 / 边框 / 表面 ============ -->
    <Color x:Key="PlcTextColor">#303133</Color>
    <Color x:Key="PlcTextSecondaryColor">#909399</Color>
    <Color x:Key="PlcBorderColor">#DCDFE6</Color>
    <Color x:Key="PlcSurfaceColor">#FFFFFF</Color>
    <Color x:Key="PlcSurfaceAltColor">#F5F7FA</Color>
    <Color x:Key="PlcSurfaceDeepColor">#ECF0F5</Color>
    <Color x:Key="PlcDarkSurfaceColor">#1F2024</Color>

    <!-- ============ 画笔 ============ -->
    <SolidColorBrush x:Key="PlcAccentBrush" Color="{StaticResource PlcAccentColor}"/>
    <SolidColorBrush x:Key="PlcSuccessBrush" Color="{StaticResource PlcSuccessColor}"/>
    <SolidColorBrush x:Key="PlcWarningBrush" Color="{StaticResource PlcWarningColor}"/>
    <SolidColorBrush x:Key="PlcDangerBrush" Color="{StaticResource PlcDangerColor}"/>
    <SolidColorBrush x:Key="PlcInfoBrush" Color="{StaticResource PlcInfoColor}"/>
    <SolidColorBrush x:Key="PlcOffBrush" Color="{StaticResource PlcOffColor}"/>
    <SolidColorBrush x:Key="PlcTextBrush" Color="{StaticResource PlcTextColor}"/>
    <SolidColorBrush x:Key="PlcTextSecondaryBrush" Color="{StaticResource PlcTextSecondaryColor}"/>
    <SolidColorBrush x:Key="PlcBorderBrush" Color="{StaticResource PlcBorderColor}"/>
    <SolidColorBrush x:Key="PlcSurfaceBrush" Color="{StaticResource PlcSurfaceColor}"/>
    <SolidColorBrush x:Key="PlcSurfaceAltBrush" Color="{StaticResource PlcSurfaceAltColor}"/>
    <SolidColorBrush x:Key="PlcSurfaceDeepBrush" Color="{StaticResource PlcSurfaceDeepColor}"/>
    <SolidColorBrush x:Key="PlcDarkSurfaceBrush" Color="{StaticResource PlcDarkSurfaceColor}"/>

    <!-- ============ 圆角 ============ -->
    <CornerRadius x:Key="PlcCardRadius">10</CornerRadius>
    <CornerRadius x:Key="PlcControlRadius">6</CornerRadius>
    <CornerRadius x:Key="PlcPillRadius">14</CornerRadius>

    <!-- ============ 阴影（已移除：DropShadowEffect 会导致高分屏离屏位图拉伸发糊；
         卡片/控件的立体感改由边框 + 背板模拟，状态灯辉光改由径向渐变模拟） ============ -->

    <!-- ============ 通用字体 ============ -->
    <FontFamily x:Key="PlcFontFamily">Segoe UI, Microsoft YaHei, PingFang SC, sans-serif</FontFamily>

    <!-- ============ 卡片边框样式（供各控件复用） ============ -->
    <Style x:Key="PlcCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PlcSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PlcBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource PlcCardRadius}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- ============ 可编辑输入框边框（强调蓝，区别于只读显示框） ============ -->
    <Style x:Key="PlcInputBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PlcSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PlcAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1.6"/>
        <Setter Property="CornerRadius" Value="{StaticResource PlcCardRadius}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- ============ 标题文本 ============ -->
    <Style x:Key="PlcHeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PlcFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PlcTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============ 次级文本 ============ -->
    <Style x:Key="PlcSecondaryText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PlcFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource PlcTextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
