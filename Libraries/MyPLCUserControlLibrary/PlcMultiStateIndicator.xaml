<local:PlcControlBase x:Class="MyPLCUserControlLibrary.PlcMultiStateIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MyPLCUserControlLibrary"
             mc:Ignorable="d"
             d:DesignHeight="44" d:DesignWidth="180"
             Background="Transparent" BorderThickness="0">

    <local:PlcControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MyPLCUserControlLibrary;component/Themes/PlcStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </local:PlcControlBase.Resources>

    <Border Style="{StaticResource PlcCardBorder}" Effect="{StaticResource PlcSoftShadow}" Padding="10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 状态指示灯 -->
            <Ellipse x:Name="PART_Indicator"
                     Grid.Column="0"
                     Width="18" Height="18" Margin="2"
                     Fill="Gray"
                     Stroke="{StaticResource PlcBorderBrush}" StrokeThickness="1">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- 状态文本 + 数值 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="{Binding CurrentStateText, RelativeSource={RelativeSource Self}}"
                           FontFamily="{StaticResource PlcFontFamily}"
                           FontSize="{Binding TextFontSize, RelativeSource={RelativeSource Self}}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PlcTextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentStateValueDisplay, RelativeSource={RelativeSource Self}}"
                           Visibility="{Binding ShowValue, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}"
                           FontFamily="{StaticResource PlcFontFamily}"
                           FontSize="{Binding ValueFontSize, RelativeSource={RelativeSource Self}}"
                           Foreground="{StaticResource PlcTextSecondaryBrush}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</local:PlcControlBase>
