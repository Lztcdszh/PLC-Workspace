<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlcFoundationValidation</RootNamespace>
    <AssemblyName>PlcFoundationValidation</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 验证程序不进发布安装包，排除敏感分析 -->
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\MyPLCFoundationLibrary\MyPLCFoundationLibrary.csproj" />
  </ItemGroup>

</Project>
